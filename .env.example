# Salin ke .env lalu isi:  cp .env.example .env
#
# Prefix PUBLIC_ = ikut ter-bundle ke JS browser. Sisanya server-only (aman untuk secret).
# Di cPanel "Setup Node.js App": isi variabel ini di UI Environment Variables app.

# ── Situs ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321

# ── Database (PostgreSQL lokal & cPanel; MySQL cPanel juga didukung) ─────────
DB_CLIENT=pg                 # pg | mysql
DB_HOST=127.0.0.1
DB_PORT=5432                 # pg 5432 | mysql 3306
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ania

# ── Sesi admin ──────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=dev-insecure-change-me

# ── Upload foto produk ──────────────────────────────────────────────────────
# Folder di luar dist/ supaya deploy ulang tidak menghapus foto.
# Lokal: kosongkan → ./uploads. cPanel: /home/USER/ania-uploads
UPLOADS_DIR=

# ── Biteship (ongkir) — SERVER-ONLY, dipakai /api/shipping ──────────────────
BITESHIP_TOKEN=
BITESHIP_ORIGIN_AREA_ID=IDNP6IDNC148IDND843IDZ12250

# ── Xendit (pembayaran) — SERVER-ONLY ──────────────────────────────────────
XENDIT_SECRET_KEY=
# Token verifikasi webhook (Xendit Dashboard → Settings → Webhooks → Verification Token)
XENDIT_WEBHOOK_TOKEN=
