# Salin ke .env lalu isi:  cp .env.example .env
#
# Prefix PUBLIC_ = ikut ter-bundle ke JS browser. Sisanya server-only (aman untuk secret).
# Di cPanel "Setup Node.js App": isi variabel ini di UI Environment Variables app.

# ── Situs ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=http://localhost:4321

# ── Database (PostgreSQL lokal & cPanel; MySQL cPanel juga didukung) ─────────
DB_CLIENT=pg                 # pg | mysql
DB_HOST=127.0.0.1
DB_PORT=5432                 # pg 5432 | mysql 3306
DB_USER=postgres
DB_PASS=postgres
DB_NAME=ania

# ── Sesi admin ──────────────────────────────────────────────────────────────
# openssl rand -hex 32
SESSION_SECRET=dev-insecure-change-me

# ── Upload foto produk ──────────────────────────────────────────────────────
# Folder di luar dist/ supaya deploy ulang tidak menghapus foto.
# Lokal: kosongkan → ./uploads. cPanel: /home/USER/ania-uploads
UPLOADS_DIR=

# ── Biteship (ongkir) — SERVER-ONLY, dipakai /api/shipping ──────────────────
BITESHIP_TOKEN=
# Tangerang pickup: Bloomingfields CR6, The HOOD, plus code PJG5+2M.
BITESHIP_ORIGIN_LATITUDE=-6.2749375
BITESHIP_ORIGIN_LONGITUDE=106.6091875
# Booking CMS is opt-in. Keep false until migration, pickup contact and live key are verified.
BITESHIP_BOOKING_ENABLED=false
BITESHIP_ORIGIN_NAME=Bloomingfields CR6, The HOOD
BITESHIP_ORIGIN_ADDRESS=Jl. Symphonia, Boulevard W No.001, Cijantra, Pagedangan, Kabupaten Tangerang, Banten 15336
# Empty uses the website contact (0821-1109-1885), approved as the pickup default.
BITESHIP_ORIGIN_PHONE=

# ── Xendit (pembayaran) — SERVER-ONLY ──────────────────────────────────────
XENDIT_SECRET_KEY=
# Token verifikasi webhook (Xendit Dashboard → Settings → Webhooks → Verification Token)
XENDIT_WEBHOOK_TOKEN=
