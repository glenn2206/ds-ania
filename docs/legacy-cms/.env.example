# cms/.env — salin: cp .env.example .env  (TIDAK di-commit)

# --- Database -----------------------------------------------------------------
# mysql  → cPanel (produksi/target)
# pg     → PostgreSQL lokal (coba-coba)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cpuser_aniacms
DB_PASS=
DB_NAME=cpuser_aniacms_dev

# --- Auth ------------------------------------------------------------------------
# openssl rand -hex 32
SESSION_SECRET=

# --- Feed & build --------------------------------------------------------------
# Kunci untuk GET /api/products.json?key=...  (samakan dgn CMS_BUILD_KEY di ~/ania-site/.env)
CMS_BUILD_KEY=

# Lokasi repo Astro & docroot DEV. HARUS di dalam ~/ dan BUKAN public_html.
SITE_DIR=/home/CPUSER/ania-site
DEPLOY_DIR=/home/CPUSER/dev-docroot

# URL publik CMS (untuk link foto di API). Passenger set PORT sendiri.
PUBLIC_BASE_URL=https://cms-dev.example.com

# Perintah build di SITE_DIR.
BUILD_CMD=npm run build
