---
/**
 * TEMPLATE · OccasionShowcase — "What Do You Want to Say?" + daftar OccasionRow.
 */
import OccasionRow from './OccasionRow.astro';
import { occasionRows } from '../../data/occasions';

interface Props {
  title?: string;
}
const { title = 'What Do You Want to Say?' } = Astro.props;
---

<section class="oshow">
  <h2 class="oshow__title type-h2">{title}</h2>
  <div class="oshow__rows">
    {occasionRows.map((row) => <OccasionRow {...row} />)}
  </div>
</section>

<style>
  .oshow {
    padding: var(--sec-y) var(--gutter);
  }
  .oshow__title {
    display: block;
    text-align: center;
    margin: 0 0 24px;
    color: #1E2934;                     /* Figma: judul section ini #1E2934, bukan --ink */
    position: sticky;
    top: var(--nav-h, 148px);
    z-index: 10;
    background: var(--bg);
    padding: 14px 0;
  }
  /* .oshow__rows > :global(.orow:last-child) {
    border-bottom: 1px solid var(--hair);
  } */
</style>
