---
/**
 * TEMPLATE · Hero — index.html screen 1.
 * Carousel gambar (Progress difungsikan: auto-advance 5s + klik segmen).
 * Token: .type-accent2 / .type-h1 / .type-h1 type--italic / .type-p1 · Button · Progress · Icon(whatsapp).
 */
import Button from '../atoms/Button.astro';
import Progress from '../atoms/Progress.astro';

interface Props {
  eyebrow?: string;
  title?: string;
  titleItalic?: string;
  checklist?: string[];
  slides?: string[];
}
const {
  eyebrow = 'ANIA Flower Boutique',
  title = 'Looking for the Perfect Flowers Today?',
  titleItalic = 'Celebrate Today with Fresh Blooms',
  checklist = [
    'Same-Day Flower Delivery',
    'Individually Crafted by Professional Florists',
    'More than 10 years Floral Design Experience',
    'Order Flowers Online Easily',
  ],  slides = ['/assets/hero-bouquet-on-table.jpg'],
} = Astro.props;
---

<section class="hero" data-hero>
  <div class="hero__slides">
    {
      slides.map((src, i) => (
        <div
          class:list={['hero__slide', i === 0 && 'is-active']}
          style={`background-image:url(${src})`}
        />
      ))
    }
  </div>

  <div class="hero__inner">
    <p class="type-accent2">{eyebrow}</p>
    <h2 class="hero__title type-h1">
      {title}<br /><span class="type-h1 type--italic">{titleItalic}</span>
    </h2>
    <div class="hero__features" data-hero-features aria-label="Flower service highlights">
      <div class="hero__feature-icons" aria-hidden="true">
        <svg class="hero__feature-icon is-active" data-feature-icon viewBox="0 0 36 36" fill="none">
          <circle class="hero__feature-clock" cx="18" cy="18" r="14" stroke-dasharray="2 2" />
          <path d="M18 12v6h4" stroke-linecap="round" />
        </svg>
        <svg class="hero__feature-icon" data-feature-icon viewBox="0 0 36 36" fill="none">
          <path d="M18 28V10M18 21c-5-2-8-7-6-12 4 2 6 7 6 12ZM18 18c5-2 8-7 6-12-4 2-6 7-6 12Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <svg class="hero__feature-icon" data-feature-icon viewBox="0 0 36 36" fill="none">
          <circle cx="18" cy="18" r="3" />
          <path d="M18 15c-8-10-15 1-3 3-12 2-5 13 3 3 8 10 15-1 3-3 12-2 5-13-3-3Z" stroke-linejoin="round" />
        </svg>
        <svg class="hero__feature-icon" data-feature-icon viewBox="0 0 36 36" fill="none">
          <rect x="11" y="7" width="14" height="22" rx="2" />
          <circle cx="18" cy="23" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </div>
      <div class="hero__feature-texts">
        {checklist.map((text, index) => (
          <p
            class:list={['hero__feature-text', index === 0 && 'is-active']}
            data-feature-text
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            {text}
          </p>
        ))}
      </div>
    </div>
    <div class="hero__cta">
      <Button href="/shop">Shop Now</Button>
      <Button variant="secondary" href="/contact">Contact Us</Button>
    </div>
  </div>

  <div class="hero__progress">
    <Progress total={slides.length} active={0} />
  </div>
</section>

<script>
  // Carousel: auto-advance + progress klik/keyboard. Jeda saat hover.
  const INTERVAL = 5000;

  document.querySelectorAll<HTMLElement>('[data-hero]').forEach((hero) => {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('.hero__slide'));
    const dots = Array.from(hero.querySelectorAll<HTMLElement>('.hero__progress .cmp-progress i'));
    if (slides.length < 2) return;

    let idx = 0;
    let timer: number | undefined;

    const render = () => {
      slides.forEach((s, i) => s.classList.toggle('is-active', i === idx));
      dots.forEach((d, i) => d.classList.toggle('on', i === idx));
    };
    const go = (n: number) => {
      idx = (n + slides.length) % slides.length;
      render();
    };
    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      stop();
      timer = window.setInterval(() => go(idx + 1), INTERVAL);
    };

    dots.forEach((d, i) => {
      d.setAttribute('role', 'button');
      d.setAttribute('tabindex', '0');
      d.setAttribute('aria-label', `Slide ${i + 1}`);
      d.style.cursor = 'pointer';
      d.addEventListener('click', () => {
        go(i);
        start();
      });
      d.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          go(i);
          start();
        }
      });
    });

    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    start();
  });

  document.querySelectorAll<HTMLElement>('[data-hero-features]').forEach((features) => {
    const icons = Array.from(features.querySelectorAll<HTMLElement>('[data-feature-icon]'));
    const texts = Array.from(features.querySelectorAll<HTMLElement>('[data-feature-text]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (icons.length < 2 || icons.length !== texts.length || reduceMotion) return;

    let current = 0;
    window.setInterval(() => {
      icons[current].classList.remove('is-active');
      texts[current].classList.remove('is-active');
      texts[current].setAttribute('aria-hidden', 'true');

      current = (current + 1) % texts.length;

      icons[current].classList.add('is-active');
      texts[current].classList.add('is-active');
      texts[current].setAttribute('aria-hidden', 'false');
    }, 2400);
  });
</script>
