---
/**
 * TEMPLATE · FlowerStory — About "A Flower for every Story".
 * Teks kiri + 2 gambar kanan yang berganti otomatis (fade/swap pasangan).
 * TANPA pagination angka — cuma panah ‹ › + auto-cycle. Pause saat hover.
 * Tiap pasangan → link ke post IG terkait (fallback: profil IG).
 */
import Icon from '../atoms/Icon.astro';
import { flowerStory as s } from '../../data/about';
---

<section class="abt-story">
  <div class="abt-story__grid">
    <div class="abt-story__text">
      <h2 class="abt-story__title">{s.titleLead}<i>{s.titleItalic}</i></h2>
      <p class="abt-story__body">{s.body}</p>
    </div>

    <div class="abt-story__slides" data-story>
      {
        s.slides.map((pair, i) => (
          <a
            class="abt-story__pair"
            data-story-pair
            hidden={i !== 0}
            href={pair[2] ?? s.instagramUrl}
            target="_blank"
            rel="noopener"
            aria-label="Lihat di Instagram"
          >
            <img src={pair[0]} alt="" loading="lazy" decoding="async" />
            <span class="abt-story__pairimg">
              <img src={pair[1]} alt="" loading="lazy" decoding="async" />
              <span class="abt-story__fade" />
            </span>
          </a>
        ))
      }
      <button class="abt-story__arw abt-story__arw--prev" type="button" data-story-prev aria-label="Sebelumnya">&#8249;</button>
      <button class="abt-story__arw abt-story__arw--next" type="button" data-story-next aria-label="Berikutnya">&#8250;</button>
    </div>
  </div>

  <div class="abt-story__foot">
    <div class="abt-story__social">
      <span class="abt-story__sociallabel">{s.socialLabel}</span>
      <span class="abt-story__socialrule"></span>
      {s.socials.map((so) => (
        <a class="abt-story__socialicon" href={so.href} target="_blank" rel="noopener" aria-label={so.label}>
          <Icon name={so.icon} size={22} alt="" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .abt-story {
    background: var(--field);
    padding: var(--sec-y) var(--gutter);
  }
  .abt-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: center;
  }
  .abt-story__title {
    margin: 0 0 20px;
    font: 400 clamp(34px, 4.2vw, 56px) / 1.1 'Cormorant Garamond', Georgia, serif;
    color: #525252;
  }
  .abt-story__title i { font-style: italic; }
  .abt-story__body {
    margin: 0;
    max-width: 34ch;
    font: 400 14px/1.7 'Open Sans', Arial, sans-serif;
    color: #1e2934;
  }

  .abt-story__slides { position: relative; }
  .abt-story__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    text-decoration: none;
  }
  .abt-story__pair[hidden] { display: none; }
  .abt-story__pair img {
    width: 100%;
    aspect-ratio: 459 / 474;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #a8a58c;
    display: block;
  }
  .abt-story__pairimg { position: relative; display: block; }
  .abt-story__fade {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(246, 235, 227, 0) 0%, var(--field) 100%);
  }

  .abt-story__arw {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    width: 30px;
    height: 30px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.7);
    color: #525252;
    font: 400 18px/1 'Open Sans', Arial, sans-serif;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  .abt-story__arw:hover { background: #fff; }
  .abt-story__arw--prev { left: -6px; }
  .abt-story__arw--next { right: -6px; }

  .abt-story__foot {
    display: flex;
    justify-content: flex-end;
    margin: 24px 0 0;
  }
  .abt-story__social { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .abt-story__sociallabel {
    font: 600 14px/1 'Open Sans', Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 5.6px;
    color: #3d3b2f;
  }
  .abt-story__socialrule { width: 56px; height: 1px; background: var(--panel); }
  .abt-story__socialicon { display: inline-flex; color: inherit; opacity: 0.75; transition: opacity 0.15s; }
  .abt-story__socialicon:hover { opacity: 1; }

  @media (max-width: 900px) {
    .abt-story__grid { grid-template-columns: 1fr; gap: 28px; }
    .abt-story__body { max-width: none; }
    .abt-story__foot { justify-content: flex-start; margin-top: 20px; }
  }
</style>

<script>
  const AUTO_MS = 5000;
  const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const pairs = Array.from(root.querySelectorAll<HTMLElement>('[data-story-pair]'));
    if (pairs.length < 2) return;
    const total = pairs.length;
    let page = 0;

    const show = () => pairs.forEach((p, i) => (p.hidden = i !== page));
    const go = (d: number) => { page = (page + d + total) % total; show(); };

    let timer = 0;
    const stop = () => { window.clearInterval(timer); timer = 0; };
    const start = () => {
      stop();
      if (REDUCE || document.hidden) return;
      timer = window.setInterval(() => go(1), AUTO_MS);
    };
    const bump = () => { stop(); window.setTimeout(start, 2000); };

    root.querySelector('[data-story-prev]')?.addEventListener('click', (e) => { e.preventDefault(); go(-1); bump(); });
    root.querySelector('[data-story-next]')?.addEventListener('click', (e) => { e.preventDefault(); go(1); bump(); });

    root.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') stop(); });
    root.addEventListener('pointerleave', (e) => { if (e.pointerType !== 'touch') start(); });
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    show();
    start();
  });
</script>
