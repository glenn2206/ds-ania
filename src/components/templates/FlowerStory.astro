---
/**
 * TEMPLATE · FlowerStory — About "A Flower for every Story".
 * Teks kiri + baris pasangan gambar kanan — geser/drag native (initHScroll,
 * sama persis logic-nya kayak OccasionRow), tanpa tombol panah.
 * Tiap pasangan → link ke post IG terkait (fallback: profil IG).
 */
import Icon from '../atoms/Icon.astro';
import { flowerStory as s } from '../../data/about';

// digandakan 2× → loop mulus (lihat lib/hscroll.ts)
const loop = [...s.slides, ...s.slides];
---

<section class="abt-story">
  <div class="abt-story__grid">
    <div class="abt-story__text">
      <h2 class="abt-story__title">{s.titleLead}<i>{s.titleItalic}</i></h2>
      <p class="abt-story__body">{s.body}</p>
    </div>

    <div class="abt-story__slides" data-story-row>
      {
        loop.map((pair, i) => (
          <a
            class="abt-story__pair"
            aria-hidden={i >= s.slides.length ? 'true' : undefined}
            href={pair[2] ?? s.instagramUrl}
            target="_blank"
            rel="noopener"
            aria-label="Lihat di Instagram"
          >
            <img src={pair[0]} alt="" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            <span class="abt-story__pairimg">
              <img src={pair[1]} alt="" loading="lazy" decoding="async" />
              <span class="abt-story__fade" />
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <div class="abt-story__foot">
    <div class="abt-story__social">
      <span class="abt-story__sociallabel">{s.socialLabel}</span>
      <span class="abt-story__socialrule"></span>
      {s.socials.map((so) => (
        <a class="abt-story__socialicon" href={so.href} target="_blank" rel="noopener" aria-label={so.label}>
          <Icon name={so.icon} size={22} alt="" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .abt-story {
    /* background: var(--field); */
    padding: var(--sec-y) var(--gutter);
  }
  .abt-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: center;
  }
  .abt-story__title {
    margin: 0 0 20px;
    font: 400 clamp(34px, 4.2vw, 56px) / 1.1 var(--font-display);
    color: #525252;
  }
  .abt-story__title i { font-style: italic; }
  .abt-story__body {
    margin: 0;
    max-width: 34ch;
    font: 400 14px/1.7 var(--font-sans);
    color: #1e2934;
  }

  .abt-story__slides {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    scroll-behavior: auto;
  }
  .abt-story__slides::-webkit-scrollbar { display: none; }
  .abt-story__slides.is-dragging { cursor: grabbing; user-select: none; }
  .abt-story__slides.is-dragging a { pointer-events: none; }
  .abt-story__pair {
    flex: 0 0 100%;
    min-width: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    text-decoration: none;
  }
  .abt-story__pair img {
    width: 100%;
    aspect-ratio: 459 / 474;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #a8a58c;
    display: block;
  }
  .abt-story__pairimg { position: relative; display: block; }
  .abt-story__fade {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(246, 235, 227, 0) 0%, var(--field) 100%);
  }

  .abt-story__foot {
    display: flex;
    justify-content: flex-end;
    margin: 24px 0 0;
  }
  .abt-story__social { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .abt-story__sociallabel {
    font: 600 14px/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 5.6px;
    color: #3d3b2f;
  }
  .abt-story__socialrule { width: 56px; height: 1px; background: var(--panel); }
  .abt-story__socialicon { display: inline-flex; color: inherit; opacity: 0.75; transition: opacity 0.15s; }
  .abt-story__socialicon:hover { opacity: 1; }

  @media (max-width: 900px) {
    .abt-story__grid { grid-template-columns: 1fr; gap: 28px; }
    .abt-story__body { max-width: none; }
    .abt-story__foot { justify-content: flex-start; margin-top: 20px; }
  }
</style>

<script>
  import { initHScroll } from '../../lib/hscroll';

  document.querySelectorAll<HTMLElement>('[data-story-row]').forEach((row) => {
    initHScroll(row);
  });
</script>
