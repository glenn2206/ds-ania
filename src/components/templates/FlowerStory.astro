---
/**
 * TEMPLATE · FlowerStory — index.html "A Flower for every Story".
 * Teks kiri (judul + body) + 2 gambar kanan (carousel). Pager BERFUNGSI:
 * klik angka / panah → ganti pasangan gambar. Baris bawah: pager + social media.
 */
import Icon from '../atoms/Icon.astro';
import { flowerStory as s } from '../../data/about';
---

<section class="abt-story" data-story>
  <div class="abt-story__grid">
    <div class="abt-story__text">
      <h2 class="abt-story__title">{s.titleLead}<i>{s.titleItalic}</i></h2>
      <p class="abt-story__body">{s.body}</p>
    </div>

    <div class="abt-story__slides" data-story-slides>
      {
        s.slides.map((pair, i) => (
          <div class="abt-story__pair" data-story-pair hidden={i !== 0}>
            <img src={pair[0]} alt="" loading="lazy" decoding="async" />
            <span class="abt-story__pairimg">
              <img src={pair[1]} alt="" loading="lazy" decoding="async" />
              <span class="abt-story__fade" />
            </span>
          </div>
        ))
      }
    </div>
  </div>

  <div class="abt-story__foot">
    <span class="cmp-pager" data-story-pager></span>

    <div class="abt-story__social">
      <span class="abt-story__sociallabel">{s.socialLabel}</span>
      <span class="abt-story__socialrule"></span>
      {s.socials.map((so) => (
        <a class="abt-story__socialicon" href={so.href} aria-label={so.label}>
          <Icon name={so.icon} size={22} alt="" />
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .abt-story {
    background: var(--field);
    padding: var(--sec-y) var(--gutter);
  }
  .abt-story__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: center;
  }
  .abt-story__title {
    margin: 0 0 20px;
    font: 400 clamp(34px, 4.2vw, 56px) / 1.1 'Cormorant Garamond', Georgia, serif;
    color: #525252;
  }
  .abt-story__title i { font-style: italic; }
  .abt-story__body {
    margin: 0;
    max-width: 34ch;
    font: 400 14px/1.7 'Open Sans', Arial, sans-serif;
    color: #1E2934;
  }
  .abt-story__slides { position: relative; }
  .abt-story__pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .abt-story__pair[hidden] { display: none; }
  .abt-story__pair img {
    width: 100%;
    aspect-ratio: 459 / 474;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #A8A58C;
    display: block;
  }
  .abt-story__pairimg { position: relative; display: block; }
  .abt-story__fade {
    position: absolute;
    inset: 0;
    border-radius: 6px;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(246, 235, 227, 0) 0%, var(--field) 100%);
  }

  .abt-story__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin: 40px 0 0;
  }
  .abt-story__foot .cmp-pager { position: static; }
  .abt-story__social {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .abt-story__sociallabel {
    font: 600 14px/1 'Open Sans', Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 5.6px;
    color: #3D3B2F;
  }
  .abt-story__socialrule { width: 56px; height: 1px; background: var(--panel); }
  .abt-story__socialicon { display: inline-flex; color: inherit; opacity: 0.75; transition: opacity 0.15s; }
  .abt-story__socialicon:hover { opacity: 1; }

  @media (max-width: 900px) {
    .abt-story__grid { grid-template-columns: 1fr; gap: 28px; }
    .abt-story__body { max-width: none; }
  }
  @media (max-width: 620px) {
    .abt-story__foot { flex-direction: column; align-items: flex-start; }
    .abt-story__social { flex-wrap: wrap; }
  }
</style>

<script>
  const ARROW_L = '/assets-svg/arrow-left-black.svg';
  const ARROW_R = '/assets-svg/arrow-right-black.svg';

  const AUTO_MS = 5000;
  const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-story]').forEach((root) => {
    const pairs = Array.from(root.querySelectorAll<HTMLElement>('[data-story-pair]'));
    const pagerBox = root.querySelector<HTMLElement>('[data-story-pager]')!;
    if (pairs.length < 2) { pagerBox.remove(); return; }
    let page = 1;
    const total = pairs.length;

    let timer = 0;
    const stop = () => { window.clearInterval(timer); timer = 0; };
    const start = () => {
      stop();
      if (REDUCE || document.hidden) return;
      timer = window.setInterval(() => { page = (page % total) + 1; render(); }, AUTO_MS);
    };

    const renderPager = () => {
      const nums = Array.from({ length: total }, (_, i) => {
        const on = i === page - 1;
        return `<span class="num ${on ? 'type-p2 type--strong on' : 'type-p2 type--faint'}" data-p="${i + 1}">${i + 1}</span>`;
      }).join('');
      pagerBox.innerHTML =
        `<img class="cmp-pager__arw" data-p="prev" src="${ARROW_L}" alt="prev">` +
        nums +
        `<img class="cmp-pager__arw" data-p="next" src="${ARROW_R}" alt="next">`;
      const prev = pagerBox.querySelector<HTMLElement>('[data-p="prev"]')!;
      const next = pagerBox.querySelector<HTMLElement>('[data-p="next"]')!;
      prev.style.opacity = page === 1 ? '0.3' : '';
      prev.style.pointerEvents = page === 1 ? 'none' : '';
      next.style.opacity = page === total ? '0.3' : '';
      next.style.pointerEvents = page === total ? 'none' : '';
    };
    const render = () => {
      pairs.forEach((p, i) => (p.hidden = i !== page - 1));
      renderPager();
    };
    pagerBox.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-p]');
      if (!el) return;
      const v = el.dataset.p!;
      if (v === 'prev') page = Math.max(1, page - 1);
      else if (v === 'next') page = Math.min(total, page + 1);
      else page = parseInt(v, 10);
      render();
      start(); // reset the countdown after a manual jump
    });

    // pause while the visitor is looking at / interacting with the slides
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    render();
    start();
  });
</script>
