---
/**
 * TEMPLATE · ShopSection — halaman katalog Shop, filter + pagination BERFUNGSI
 * (client-side, situs tetap statik).
 * judul .type-h2 + ShopSidebar (kiri) + [toolbar sort/filter, grid ProductCard, PageNav].
 */
import ShopSidebar from '../organisms/ShopSidebar.astro';
import ProductCard from '../organisms/ProductCard.astro';
import Icon from '../atoms/Icon.astro';
import { toProduct } from '../../data/shop';
import type { FilterGroupData } from '../../data/shop';
import type { CatalogItem } from '../../data/catalog';

interface Props {
  title: string;
  groups: FilterGroupData[];
  items: CatalogItem[];
  perPage?: number;
  /** kategori aktif awal (slug), mis. "premium-wrapped" */
  activeCategory?: string;
  /** filter awal generik dari query (?cat / ?occasion / ?flower) — menimpa activeCategory */
  activeFilter?: { group: string; value: string };
}
const { title, groups, items, perPage = 9, activeCategory = '', activeFilter } = Astro.props;

const searchText = (c: CatalogItem) =>
  [c.name, c.pill, c.flowers, c.occasion ?? '', c.description]
    .join(' ')
    .toLowerCase();
---

<section
  class="shop"
  data-shop
  data-per-page={perPage}
  data-active-category={activeCategory}
  data-active-filter={activeFilter ? JSON.stringify(activeFilter) : ''}
>
  {/* tombol buka (+) / tutup (×) sidebar — SATU ikon (+ di-rotate 45° jadi ×),
      sejajar baris judul; posisi mengambang ikut lebar sidebar (lihat CSS) */}
  <button type="button" class="shop__title-toggle" data-side-toggle aria-label="Toggle filters" aria-expanded="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12h14" />
    </svg>
  </button>
  <h1 class="type-h2 shop__title" data-shop-title>{title}</h1>

  {/* mobile (≤900px) — bar "FILTER" full-width, ganti tombol +/× (yang cuma
      cocok buat rail sidebar desktop); klik → buka popup full-screen */}
  <button type="button" class="shop__mobile-filterbtn" data-side-toggle aria-expanded="false">Filter</button>

  <div class="shop__layout">
    <ShopSidebar groups={groups} />

    <div class="shop__main">
      <div class="shop__toolbar">
        <label class="shop__sort">
          <select data-sort>
            <option value="default">Default sorting</option>
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="name">Name: A–Z</option>
          </select>
          <svg class="shop__sort-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </label>
        <button class="shop__filterbtn" type="button" aria-label="Filter" data-filter-toggle>
          <Icon name="burger" size={18} alt="filter" />
        </button>
      </div>

      <div class="shop__grid" data-grid>
        {
          items.map((c, i) => (
            <div
              class="shop__cell"
              data-cell
              data-cat={c.category}
              data-name={c.name}
              data-price={c.price ?? ''}
              data-search={searchText(c)}
              data-index={i}
            >
              <ProductCard {...toProduct(c)} slug={c.slug} href={`/product/${c.slug}`} />
            </div>
          ))
        }
      </div>

      <p class="shop__empty" data-empty hidden>No products match this filter.</p>
      <div class="shop__pager" data-pagenav></div>
    </div>
  </div>
</section>

<script>
  // ---- Shop engine: filter (sidebar) + sort + pagination, semua di browser ----
  const CAT_LABEL: Record<string, string> = {
    'bloom-box': 'Bloom Box & Basket',
    'premium-wrapped': 'Premium Wrapped Bloom',
    standing: 'Standing Flower & Flower Board',
    vase: 'Vase',
    accessory: 'Add On Extras',
    preserved: 'Preserved Flower',
  };

  document.querySelectorAll<HTMLElement>('[data-shop]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]')!;
    const cells = Array.from(root.querySelectorAll<HTMLElement>('[data-cell]'));
    const pagerBox = root.querySelector<HTMLElement>('[data-pagenav]')!;
    const emptyMsg = root.querySelector<HTMLElement>('[data-empty]')!;
    const titleEl = root.querySelector<HTMLElement>('[data-shop-title]')!;
    const sortSel = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const perPage = parseInt(root.dataset.perPage || '9', 10);

    let filter: { group: string; value: string } = {
      group: 'category',
      value: root.dataset.activeCategory || '',
    };
    try {
      const af = root.dataset.activeFilter ? JSON.parse(root.dataset.activeFilter) : null;
      if (af && af.group) filter = { group: String(af.group), value: String(af.value || '') };
    } catch {}
    let page = 1;

    // sorot item sidebar yang cocok dengan filter awal (dari query)
    const highlightInitial = () => {
      if (!filter.value && filter.group !== 'all') return;
      const link = root.querySelector<HTMLElement>(
        `[data-filter][data-group="${filter.group}"][data-value="${filter.value}"]`,
      );
      if (!link) return;
      root.querySelectorAll('.filtergrp__item.is-active').forEach((x) => x.classList.remove('is-active'));
      link.closest('.filtergrp__item')?.classList.add('is-active');
      link.closest('.filtergrp')?.classList.remove('is-collapsed');
    };

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // scroll balik ke atas grid — offset navbar sticky, dan hanya kalau user memang sudah scroll lewat
    const scrollToGrid = () => {
      const navH = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--nav-h')) || 80;
      const target = Math.max(0, window.scrollY + grid.getBoundingClientRect().top - navH - 12);
      if (window.scrollY <= target + 8) return;
      window.scrollTo({ top: target, behavior: reduce ? 'auto' : 'smooth' });
    };

    // fade-up bertahap untuk kartu yang baru tampil
    const animateIn = (els: HTMLElement[]) => {
      if (reduce) return;
      els.forEach((el, i) => {
        (el.querySelector('.pcard') || el).animate(
          [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }],
          { duration: 320, delay: Math.min(i, 8) * 40, easing: 'cubic-bezier(.2,.6,.2,1)', fill: 'backwards' },
        );
      });
    };

    const num = (el: HTMLElement) => parseInt(el.dataset.price || '0', 10);
    const byName = (a: HTMLElement, b: HTMLElement) =>
      (a.dataset.name || '').localeCompare(b.dataset.name || '');

    const matches = (el: HTMLElement) => {
      const { group, value } = filter;
      if (!value || group === 'all') return true;
      if (group === 'category') return el.dataset.cat === value;
      if (group === 'sale') return el.dataset.sale === 'true';
      if (group === 'addon')
        return el.dataset.cat === 'accessory' && (el.dataset.name || '').toLowerCase() === value;
      // occasion / flower → cocokkan substring ke data-search
      return (el.dataset.search || '').includes(value.toLowerCase());
    };

    const sorted = (list: HTMLElement[]) => {
      const v = sortSel.value;
      if (v === 'default')
        return list.slice().sort((a, b) => +(a.dataset.index || 0) - +(b.dataset.index || 0));
      // produk tanpa harga ("by request") selalu di belakang, apa pun arah sort
      const priced = list.filter((el) => el.dataset.price);
      const unpriced = list.filter((el) => !el.dataset.price);
      if (v === 'price-asc') priced.sort((a, b) => num(a) - num(b));
      else if (v === 'price-desc') priced.sort((a, b) => num(b) - num(a));
      else if (v === 'name') { priced.sort(byName); unpriced.sort(byName); }
      return [...priced, ...unpriced];
    };

    const pageList = (total: number): (number | '…')[] => {
      if (total <= 5) return Array.from({ length: total }, (_, i) => i + 1);
      const keep = new Set<number>([1, total, page, page - 1, page + 1]);
      if (page <= 3) { keep.add(2); keep.add(3); }
      if (page >= total - 2) { keep.add(total - 1); keep.add(total - 2); }
      const nums = [...keep].filter((n) => n >= 1 && n <= total).sort((a, b) => a - b);
      const out: (number | '…')[] = [];
      nums.forEach((n, i) => {
        if (i > 0 && n - nums[i - 1] > 1) out.push('…');
        out.push(n);
      });
      return out;
    };

    const renderPager = (total: number) => {
      if (total <= 1) { pagerBox.innerHTML = ''; return; }
      const prev =
        page > 1
          ? `<li class="cmp-pagenav__prev"><a href="#" data-page="${page - 1}" aria-label="Previous page"><img class="ico" src="/assets-svg/arrow-left-black.svg" alt=""></a></li>`
          : '';
      const nums = pageList(total)
        .map((it) =>
          it === '…'
            ? `<li class="cmp-pagenav__gap" aria-hidden="true">…</li>`
            : `<li class="cmp-pagenav__item${it === page ? ' is-current' : ''}"><a href="#" data-page="${it}" ${it === page ? 'aria-current="page"' : ''}>${it}</a></li>`,
        )
        .join('');
      const next =
        page < total
          ? `<li class="cmp-pagenav__next"><a href="#" data-page="${page + 1}" aria-label="Next page"><img class="ico" src="/assets-svg/arrow-right-black.svg" alt=""></a></li>`
          : '';
      pagerBox.innerHTML =
        `<nav class="cmp-pagenav" aria-label="Pagination"><ol class="cmp-pagenav__list">${prev}${nums}${next}</ol></nav>`;
    };

    const apply = () => {
      const visible = sorted(cells.filter(matches));
      cells.forEach((c) => (c.hidden = true));
      const totalPages = Math.max(1, Math.ceil(visible.length / perPage));
      if (page > totalPages) page = 1;
      const start = (page - 1) * perPage;
      const shown = visible.slice(start, start + perPage);
      shown.forEach((c) => (c.hidden = false));
      // urutan tampil sesuai hasil sort
      visible.forEach((c) => grid.appendChild(c));
      emptyMsg.hidden = visible.length !== 0;
      renderPager(totalPages);
      animateIn(shown);
      // judul ikut kategori aktif
      if (filter.group === 'category' && filter.value) titleEl.textContent = CAT_LABEL[filter.value] || titleEl.textContent;
      else if (filter.group === 'all') titleEl.textContent = 'All Products';
    };

    // ---- sidebar: rail (collapsed) ↔ panel penuh (expanded, dorong grid 4→3 kolom) ----
    const toggleBtn = root.querySelector<HTMLElement>('[data-filter-toggle]');

    const focusGroup = (grp?: string) => {
      if (!grp) return;
      root.querySelectorAll('.filtergrp[data-collapsible]').forEach((g) => g.classList.add('is-collapsed'));
      root
        .querySelector(`[data-filter][data-group="${grp}"]`)
        ?.closest('.filtergrp')
        ?.classList.remove('is-collapsed');
    };
    const expand = (grp?: string) => {
      root.classList.add('is-expanded');
      toggleBtn?.setAttribute('aria-expanded', 'true');
      // mobile: popup full-screen → kunci scroll halaman di belakangnya
      if (window.innerWidth <= 900) document.documentElement.style.overflow = 'hidden';
      focusGroup(grp);
    };
    const collapse = () => {
      root.classList.remove('is-expanded');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = '';
    };
    const toggleSide = () => (root.classList.contains('is-expanded') ? collapse() : expand());

    // sidebar filter (link di panel) — sidebar tetap terbuka, user bebas ganti-ganti filter
    root.querySelectorAll<HTMLAnchorElement>('[data-filter]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        root.querySelectorAll('.filtergrp__item.is-active').forEach((x) => x.classList.remove('is-active'));
        a.closest('.filtergrp__item')?.classList.add('is-active');
        filter = { group: a.dataset.group || 'all', value: a.dataset.value || '' };
        page = 1;
        apply();
        scrollToGrid();
      });
    });

    // sort
    sortSel.addEventListener('change', () => { page = 1; apply(); });

    // pagination (delegasi — pager di-render ulang)
    pagerBox.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLElement>('[data-page]');
      if (!a) return;
      e.preventDefault();
      page = parseInt(a.dataset.page || '1', 10);
      apply();
      scrollToGrid();
    });

    // rail (collapsed): klik ikon grup → buka sidebar penuh + fokus ke grup itu
    root.querySelectorAll<HTMLElement>('[data-rail-btn]').forEach((b) => {
      b.addEventListener('click', () => expand(b.dataset.railGroup || ''));
    });

    // tombol + (rail) / × (panel) / ikon filter toolbar → buka-tutup sidebar
    root.querySelectorAll<HTMLElement>('[data-side-toggle]').forEach((b) => {
      b.addEventListener('click', toggleSide);
    });
    toggleBtn?.addEventListener('click', toggleSide);

    // diperbesar ke desktop saat popup mobile terbuka → lepas kunci scroll (popup jadi sidebar inline biasa)
    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) document.documentElement.style.overflow = '';
    });

    highlightInitial();
    // buka sidebar otomatis kalau halaman dibuka dengan filter spesifik dari query —
    // HANYA desktop (di mobile popup full-screen jangan langsung nutupin halaman saat load)
    if (filter.value && filter.group !== 'all' && window.innerWidth > 900) expand(filter.group);
    apply();
  });
</script>
