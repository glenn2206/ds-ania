---
/**
 * TEMPLATE · CareInstructions — grid 3×2 (ikon + judul + teks). Teks dari index.html.
 */
import Icon from '../atoms/Icon.astro';
import { careInstructions } from '../../data/care';
---

<section class="care">
  <h2 class="ts-07 care__title">Care Instructions</h2>
  <div class="care__grid">
    {
      careInstructions.map((c) => (
        <article class="care__item">
          <Icon name={c.icon} size={30} alt="" class="care__icon" />
          <h3 class="care__itemtitle">{c.title}</h3>
          <p class="care__body">{c.body}</p>
        </article>
      ))
    }
  </div>
</section>
