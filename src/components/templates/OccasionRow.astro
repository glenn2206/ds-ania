---
/**
 * TEMPLATE · OccasionRow — satu pita occasion di "What Do You Want to Say?".
 * Figma something.html: eyebrow + judul serif RATA TENGAH DI ATAS (bukan rail kiri),
 * lalu carousel ProductCard full-width di bawahnya — geser/klik pakai swipe/drag native
 * (initHScroll), tanpa tombol panah.
 */
import ProductCard from '../organisms/ProductCard.astro';
import type { OccasionRow } from '../../data/occasions';

interface Props extends OccasionRow {}
const { eyebrow, title, products } = Astro.props;

// digandakan 2× → loop mulus (lihat lib/hscroll.ts)
const loop = [...products, ...products];
---

<div class="orow" data-occ-row>
  <div class="orow__head">
    <span class="orow__eyebrow">{eyebrow}</span>
    <h3 class="type-h1--section orow__title">{title}</h3>
  </div>

  <div class="orow__cards" data-occ-cards>
    {
      loop.map((p, i) => (
        <div class="orow__cell" aria-hidden={i >= products.length ? 'true' : undefined}>
          <ProductCard {...p} />
        </div>
      ))
    }
  </div>
</div>

<style>
  .orow {
    padding: 40px 0;
    /* border-top: 1px solid var(--hair); */
  }
  .orow__head {
    text-align: center;
    margin: 0 0 32px;
  }
  .orow__eyebrow {
    display: block;
    font: 600 14px/1 'Open Sans', Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 5.6px;
    color: #525252;
  }
  .orow__title {
    margin: 6px 0 0;
    color: #3d3b2f;
  }

  .orow__cards {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    scroll-behavior: auto;
  }
  .orow__cards::-webkit-scrollbar { display: none; }
  .orow__cards.is-dragging { cursor: grabbing; user-select: none; }
  .orow__cards.is-dragging :global(a) { pointer-events: none; }
  .orow__cell { flex: 0 0 clamp(240px, 24%, 307px); min-width: 0; }
  .orow__cards :global(.pcard) { width: 100%; }
  .orow__cards :global(.pcard__media) { height: auto; aspect-ratio: 1 / 1; }  /* Figma: foto kartu occasion 307×307, persegi */
  .orow__cards :global(.pcard) .type-h2 { font-size: 20px; color: #1E2934; }  /* Figma: judul kartu 20px */
  .orow__cards :global(.pcard__price) .type-p2 { font-size: 12px; }          /* Figma: harga kartu 12px */
  .orow__cards :global(.cmp-pill--sand) { outline-color: #EAE8E8; }          /* Figma: outline pill kategori #EAE8E8 */

  @media (max-width: 640px) {
    .orow__title { font-size: 40px; }
    .orow__cell { flex: 0 0 78%; }
  }
</style>

<script>
  import { initHScroll } from '../../lib/hscroll';

  document.querySelectorAll<HTMLElement>('[data-occ-row]').forEach((rowEl) => {
    const cards = rowEl.querySelector<HTMLElement>('[data-occ-cards]');
    if (!cards) return;
    initHScroll(cards);
  });
</script>
