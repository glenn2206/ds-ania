---
/**
 * TEMPLATE · OccasionRow — satu pita occasion di "What Do You Want to Say?".
 * Rel kiri (eyebrow + judul serif + panah) + carousel ProductCard di kanan —
 * pola sliding SAMA dengan "Choose your Flower" di landing (marquee mulus + drag).
 */
import ProductCard from '../organisms/ProductCard.astro';
import type { OccasionRow } from '../../data/occasions';

interface Props extends OccasionRow {}
const { eyebrow, title, products } = Astro.props;

// digandakan 2× → loop mulus (lihat lib/hscroll.ts)
const loop = [...products, ...products];
---

<div class="orow" data-occ-row>
  <div class="orow__rail">
    <span class="orow__eyebrow">{eyebrow}</span>
    <h3 class="orow__title">{title}</h3>
    <div class="orow__nav">
      <button class="orow__arw" type="button" data-occ-prev aria-label="Sebelumnya">&#8249;</button>
      <button class="orow__arw" type="button" data-occ-next aria-label="Berikutnya">&#8250;</button>
    </div>
  </div>

  <div class="orow__cards" data-occ-cards>
    {
      loop.map((p, i) => (
        <div class="orow__cell" aria-hidden={i >= products.length ? 'true' : undefined}>
          <ProductCard {...p} />
        </div>
      ))
    }
  </div>
</div>

<style>
  .orow {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
    padding: 40px 0;
    border-top: 1px solid var(--hair);
  }
  .orow__rail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    padding-top: 6px;
  }
  .orow__eyebrow {
    font: 600 14px/1 'Open Sans', Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 5.6px;
    color: #525252;
  }
  .orow__title {
    margin: 0;
    font: 600 52px/1.05 'Cormorant Garamond', Georgia, serif;
    color: #3d3b2f;
  }
  .orow__nav { display: flex; gap: 10px; margin-top: 4px; }
  .orow__arw {
    width: 38px; height: 38px; border-radius: 50%;
    border: 1px solid var(--sand); background: #fff; color: #3d3b2f;
    font: 400 20px/1 'Open Sans', Arial, sans-serif;
    display: grid; place-items: center; cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }
  .orow__arw:hover { background: var(--olive); color: #fff; border-color: var(--olive); }

  .orow__cards {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    cursor: grab;
    scroll-behavior: auto;
  }
  .orow__cards::-webkit-scrollbar { display: none; }
  .orow__cards.is-dragging { cursor: grabbing; user-select: none; }
  .orow__cards.is-dragging :global(a) { pointer-events: none; }
  .orow__cell { flex: 0 0 clamp(240px, 32%, 320px); min-width: 0; }
  .orow__cards :global(.pcard) { width: 100%; }
  .orow__cards :global(.pcard__media) { height: auto; aspect-ratio: 320 / 406; }

  @media (max-width: 1180px) {
    .orow { grid-template-columns: 1fr; gap: 20px; }
  }
  @media (max-width: 640px) {
    .orow__title { font-size: 40px; }
    .orow__cell { flex: 0 0 78%; }
    .orow__nav { display: none; }
  }
</style>

<script>
  import { initHScroll } from '../../lib/hscroll';

  document.querySelectorAll<HTMLElement>('[data-occ-row]').forEach((rowEl) => {
    const cards = rowEl.querySelector<HTMLElement>('[data-occ-cards]');
    if (!cards) return;
    initHScroll(cards, {
      prev: rowEl.querySelector<HTMLElement>('[data-occ-prev]'),
      next: rowEl.querySelector<HTMLElement>('[data-occ-next]'),
    });
  });
</script>
