---
/**
 * TEMPLATE · SendToSection — "Who Are You Sending Flowers To?".
 * Grid 3 kolom: 5 SendToCard + 1 sel "For Those Unspoken Words" (eyebrow + judul + tombol).
 */
import SendToCard from '../organisms/SendToCard.astro';
import Button from '../atoms/Button.astro';
import { sendTo, unspoken } from '../../data/occasions';

interface Props {
  title?: string;
}
const { title = 'Who Are You Sending Flowers To?' } = Astro.props;
---

<section class="sendto">
  <h2 class="sendto__title type-h2">{title}</h2>
  <div class="sendto__grid">
    {sendTo.map((c) => <SendToCard {...c} />)}

    <article class="sendto__card sendto__card--unspoken">
      <span class="sendto__eyebrow">{unspoken.eyebrow}</span>
      <h3 class="type-h3 sendto__tt sendto__tt--lg">{unspoken.title}</h3>
      <p class="sendto__bd">{unspoken.body}</p>
      <Button href={unspoken.cta.href}>{unspoken.cta.label}</Button>
    </article>
  </div>
</section>

<style>
  .sendto {
    padding: var(--sec-y) var(--gutter);
    --rule: var(--sand); /* #CCC8A8 — warm khaki hairline */
  }
  .sendto__title {
    display: block;
    text-align: center;
    margin: 0 0 40px;
    color: #3D3B2F;                     /* Figma: judul section ini #3D3B2F */
  }
  .sendto__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    max-width: 1160px;
    margin: 0 auto;
    border-top: 1px solid var(--rule);
  }
  /* hairlines between cells — top rule + column rules + one row rule.
     :global(.sendto__card) reaches the <SendToCard> roots (all 6 cells carry it). */
  .sendto__grid > :global(.sendto__card) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 44px 40px;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .sendto__grid > :global(.sendto__card:nth-child(3n + 1)) { padding-left: 0; }
  .sendto__grid > :global(.sendto__card:nth-child(3n)) {
    padding-right: 0;
    border-right: 0;
  }
  .sendto__grid > :global(.sendto__card:nth-child(n + 4)) {
    padding-bottom: 0;
    border-bottom: 0;
  }
  /* card contents live in child components (SendToCard) → :global to reach them */
  .sendto__grid :global(.sendto__ico) { opacity: 0.85; margin-bottom: 12px; }
  .sendto__grid :global(.sendto__tt) { margin: 0; }
  .sendto__grid :global(.sendto__tt--lg) { font-size: 48px; font-weight: 400; line-height: 1.1; }
  .sendto__grid :global(.sendto__bd) {
    margin: 0;
    font: 400 14px/1.5 var(--font-sans);
    color: #3D3B2F;
  }
  .sendto__grid :global(.sendto__best) {
    margin: 0;
    font: 600 14px/1.5 var(--font-sans);
    color: #3D3B2F;
  }
  .sendto__card--unspoken { gap: 8px; }
  .sendto__eyebrow {
    font: 600 12px/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 4.8px;
    color: #525252;
  }
  .sendto__card--unspoken :global(.cmp-btn-primary) { margin-top: 8px; }

  @media (max-width: 1000px) {
    .sendto__grid {
      grid-template-columns: repeat(2, 1fr);
      column-gap: 40px;
      border-top: 0;
    }
    .sendto__grid > :global(.sendto__card) {
      padding: 32px 0;
      border-right: 0;
      border-bottom: 1px solid var(--rule);
    }
    .sendto__grid > :global(.sendto__card:nth-child(n + 4)) {
      padding-bottom: 32px;
      border-bottom: 1px solid var(--rule);
    }
    .sendto__grid > :global(.sendto__card:last-child) { border-bottom: 0; }
  }
  @media (max-width: 640px) {
    .sendto__grid { grid-template-columns: 1fr; }
    .sendto__tt--lg { font-size: 34px; }
  }
</style>
