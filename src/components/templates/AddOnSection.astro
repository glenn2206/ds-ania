---
/**
 * TEMPLATE · AddOnSection — index.html "Make It Personal".
 * Kolom teks kiri (.ts-06 + .ts-16 + Button) + 3 OccasionCard (action="plus").
 */
import Button from '../atoms/Button.astro';
import OccasionCard from '../organisms/OccasionCard.astro';

interface Card {
  image: string;
  title: string;
  price: string;
  slug?: string;
}
interface Props {
  title?: string;
  subtitle?: string;
  cta?: string;
  cards: Card[];
}
const {
  title = 'Make It Personal',
  subtitle = 'Complete your bouquet with a special add-on, thoughtfully chosen to make your gift even more meaningful.',
  cta = 'View All Add-on',
  cards,
} = Astro.props;
---

<section class="addon">
  <div class="addon__text">
    <span class="ts-06">{title}</span>
    <span class="ts-16">{subtitle}</span>
    <Button>{cta}</Button>
  </div>
  <div class="addon__cards">
    {cards.map((c) => <OccasionCard image={c.image} title={c.title} price={c.price} action="plus" slug={c.slug} />)}
  </div>
</section>
