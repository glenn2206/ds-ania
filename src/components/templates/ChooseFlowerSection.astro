---
/**
 * TEMPLATE · ChooseFlowerSection — landing "Choose your Flower by …".
 * Figma: heading Cormorant 32/500 + 3 tab teks polos (garis bawah) + 3 tile
 * gambar besar (label + chevron DI BAWAH gambar) + tombol "View All".
 * Tile diturunkan dinamis dari katalog per tab (Occasions / Category / Flower).
 */
import Button from '../atoms/Button.astro';
import { chooseTabs, chooseTilesFrom, chooseHeadingLead } from '../../data/choose';
import { getCatalog } from '../../lib/products';
import { buildFacets } from '../../lib/facets';

interface Props {
  activeTab?: (typeof chooseTabs)[number];
}
const { activeTab = 'Occasions' } = Astro.props;

const cat = await getCatalog();
const chooseTiles = chooseTilesFrom(buildFacets([...cat.allProducts, ...cat.addons]));
// Figma: 3 tile per tab
const base = chooseTabs.flatMap((tab) => chooseTiles[tab].slice(0, 3).map((t) => ({ ...t, tab })));
---

<section class="choose" data-choose data-active-tab={activeTab}>
  <h2 class="choose__head">
    {chooseHeadingLead}<br />Choose your Flower by ...
  </h2>

  <div class="choose__tabs" role="tablist" aria-label="Choose your flower by">
    {
      chooseTabs.map((t) => (
        <button
          type="button"
          class:list={['choose__tab', t === activeTab && 'choose__tab--on']}
          data-choose-tab={t}
          role="tab"
          aria-selected={t === activeTab ? 'true' : 'false'}
        >
          {t}
        </button>
      ))
    }
  </div>

  <div class="choose__row" data-choose-row>
    {
      base.map((t) => (
        <a class="choose__tile" href={t.href} data-tab={t.tab} aria-label={t.label} hidden>
          <span class="choose__tileimg" style={`background-image:url(${t.image})`} />
          <span class="choose__tilelabel">
            <span>{t.label}</span>
          </span>
        </a>
      ))
    }
  </div>

  <div class="choose__foot">
    <Button href="/occasions">View All {activeTab}</Button>
  </div>
</section>

<script>
  const CTA_LINK: Record<string, string> = { Occasions: '/occasions', Category: '/shop', Flower: '/shop' };

  document.querySelectorAll<HTMLElement>('[data-choose]').forEach((root) => {
    const tiles = Array.from(root.querySelectorAll<HTMLElement>('[data-tab]'));
    const tabBtns = Array.from(root.querySelectorAll<HTMLElement>('[data-choose-tab]'));
    const byEl = root.querySelector<HTMLElement>('[data-choose-by]');
    const cta = root.querySelector<HTMLAnchorElement>('.choose__foot a');
    const rowEl = root.querySelector<HTMLElement>('[data-choose-row]');
    let tab = root.dataset.activeTab || 'Occasions';

    const render = () => {
      tiles.forEach((c) => (c.hidden = c.dataset.tab !== tab));
      tabBtns.forEach((b) => {
        const on = b.dataset.chooseTab === tab;
        b.classList.toggle('choose__tab--on', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      if (byEl) byEl.textContent = tab;
      if (cta) {
        cta.textContent = `View All ${tab}`;
        cta.href = CTA_LINK[tab] || '/occasions';
      }
      if (rowEl) rowEl.scrollLeft = 0;
    };

    tabBtns.forEach((b) =>
      b.addEventListener('click', () => {
        tab = b.dataset.chooseTab || tab;
        render();
      }),
    );

    render();
  });
</script>
