---
/**
 * TEMPLATE · ChooseFlowerSection — index.html "Choose your Flower by …".
 * Tab (Occasions / Category / Flower) + 3 CategoryTile + Pager — semua DINAMIS
 * (client-side): klik tab ganti isi + subjudul + heading; pager jalan per tab.
 */
import Button from '../atoms/Button.astro';
import CategoryTile from '../organisms/CategoryTile.astro';
import {
  chooseTabs,
  chooseTiles,
  chooseSub,
  chooseHeadingLead,
  CHOOSE_PER_PAGE,
} from '../../data/choose';

interface Props {
  activeTab?: (typeof chooseTabs)[number];
}
const { activeTab = 'Occasions' } = Astro.props;

const allTiles = chooseTabs.flatMap((tab) =>
  chooseTiles[tab].map((t) => ({ ...t, tab })),
);
---

<section
  class="choose"
  data-choose
  data-per-page={CHOOSE_PER_PAGE}
  data-active-tab={activeTab}
  data-subs={JSON.stringify(chooseSub)}
>
  <div class="cflow__head">
    <span class="type-h2">
      {chooseHeadingLead}<br />Choose your Flower by <span data-choose-by>{activeTab}</span>
    </span>
  </div>

  <div class="cflow">
    <div class="cflow__tabs">
      {
        chooseTabs.map((t) => (
          <button
            type="button"
            class:list={['cflow__tab', t === activeTab && 'cflow__tab--on']}
            data-choose-tab={t}
          >
            {t}
          </button>
        ))
      }
    </div>

    <div class="cflow__panel">
      <p class="cflow__sub type-p1" data-choose-sub>{chooseSub[activeTab]}</p>

      <div class="cflow__row" data-choose-row>
        {
          allTiles.map((t) => (
            <div class="cflow__cell" data-choose-cell data-tab={t.tab} hidden>
              <CategoryTile image={t.image} label={t.label} olive={t.olive} />
            </div>
          ))
        }
      </div>

      <div class="cflow__foot">
        <Button href="/occasions">Check Other {activeTab}</Button>
        <span class="cmp-pager" data-choose-pager></span>
      </div>
    </div>
  </div>
</section>

<script>
  const ARROW_L = '/assets-svg/arrow-left-black.svg';
  const ARROW_R = '/assets-svg/arrow-right-black.svg';
  // tujuan tombol "Check Other …" per tab
  const CTA_LINK: Record<string, string> = {
    Occasions: '/occasions',
    Category: '/shop',
    Flower: '/shop',
  };

  document.querySelectorAll<HTMLElement>('[data-choose]').forEach((root) => {
    const per = parseInt(root.dataset.perPage || '3', 10);
    const subs: Record<string, string> = JSON.parse(root.dataset.subs || '{}');
    const cells = Array.from(root.querySelectorAll<HTMLElement>('[data-choose-cell]'));
    const tabBtns = Array.from(root.querySelectorAll<HTMLElement>('[data-choose-tab]'));
    const pagerBox = root.querySelector<HTMLElement>('[data-choose-pager]')!;
    const byEl = root.querySelector<HTMLElement>('[data-choose-by]')!;
    const subEl = root.querySelector<HTMLElement>('[data-choose-sub]')!;
    const ctaEl = root.querySelector<HTMLElement>('.cflow__foot .cmp-btn-primary');

    let tab = root.dataset.activeTab || tabBtns[0]?.dataset.chooseTab || '';
    let page = 1;

    const tabCells = () => cells.filter((c) => c.dataset.tab === tab);
    const pageCount = () => Math.max(1, Math.ceil(tabCells().length / per));

    const renderPager = () => {
      const pc = pageCount();
      if (pc <= 1) { pagerBox.innerHTML = ''; return; }
      const nums = Array.from({ length: pc }, (_, i) => {
        const on = i === page - 1;
        return `<span class="num ${on ? 'type-p2 type--strong on' : 'type-p2 type--faint'}" data-p="${i + 1}">${i + 1}</span>`;
      }).join('');
      pagerBox.innerHTML =
        `<img class="cmp-pager__arw" data-p="prev" src="${ARROW_L}" alt="prev">` +
        nums +
        `<img class="cmp-pager__arw" data-p="next" src="${ARROW_R}" alt="next">`;
      const prev = pagerBox.querySelector<HTMLElement>('[data-p="prev"]')!;
      const next = pagerBox.querySelector<HTMLElement>('[data-p="next"]')!;
      prev.style.opacity = page === 1 ? '0.3' : '';
      prev.style.pointerEvents = page === 1 ? 'none' : '';
      next.style.opacity = page === pc ? '0.3' : '';
      next.style.pointerEvents = page === pc ? 'none' : '';
    };

    const render = () => {
      cells.forEach((c) => (c.hidden = true));
      const tc = tabCells();
      const start = (page - 1) * per;
      tc.slice(start, start + per).forEach((c) => (c.hidden = false));
      tabBtns.forEach((b) => b.classList.toggle('cflow__tab--on', b.dataset.chooseTab === tab));
      byEl.textContent = tab;
      subEl.textContent = subs[tab] || subEl.textContent;
      if (ctaEl) {
        ctaEl.textContent = `Check Other ${tab}`;
        (ctaEl as HTMLAnchorElement).href = CTA_LINK[tab] || '/occasions';
      }
      renderPager();
    };

    tabBtns.forEach((b) =>
      b.addEventListener('click', () => {
        tab = b.dataset.chooseTab || tab;
        page = 1;
        render();
      }),
    );

    pagerBox.addEventListener('click', (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>('[data-p]');
      if (!el) return;
      const v = el.dataset.p!;
      const pc = pageCount();
      if (v === 'prev') page = Math.max(1, page - 1);
      else if (v === 'next') page = Math.min(pc, page + 1);
      else page = parseInt(v, 10);
      render();
    });

    render();
  });
</script>
