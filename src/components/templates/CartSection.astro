---
/**
 * TEMPLATE · CartSection — halaman keranjang. Berfungsi penuh (client-side):
 * item + qty + hapus (localStorage), ongkir via Biteship, total, checkout → WhatsApp.
 * Kiri: daftar item + info & form pengiriman. Kanan: Continue Shopping + Cart Totals.
 */
import DeliveryFields from '../organisms/DeliveryFields.astro';
import { office } from '../../data/contact';

/** nomor WA butik untuk kirim ringkasan order */
const WA_NUMBER = '6281211091885';
---

<section class="cart" data-cart data-wa={WA_NUMBER} data-pickup-address={office.address.join(', ')}>
  <div class="cart__grid">
    <!-- ============ KIRI ============ -->
    <div class="cart__left">
      <ul class="cart__items" data-items></ul>

      <p class="cart__empty" data-empty hidden>
        Your cart is empty. <a href="/shop">Browse our bouquets →</a>
      </p>

      <DeliveryFields cart />
    </div>

    <!-- ============ KANAN ============ -->
    <div class="cart__right">
      <a class="cart__continue" href="/shop">Continue Shopping?</a>

      <div class="cart__totals" data-totals hidden>
        <h2 class="cart__totalstitle">Cart Totals</h2>
        <div class="cart__row"><span>Subtotal</span><b data-subtotal>Rp 0</b></div>
        <div class="cart__row"><span>Delivery</span><b data-delivery-cost>—</b></div>
        <div class="cart__row cart__row--total"><span>Total</span><b data-total>Rp 0</b></div>
        <button class="cart__checkout" type="button" data-checkout>
          Proceed to Checkout — <span data-checkout-total>Rp 0</span>
        </button>
        <p class="cart__note" data-checkoutnote hidden></p>
      </div>
    </div>
  </div>
</section>

<template data-line-tpl>
  <li class="cart__item">
    <button class="cart__remove" type="button" aria-label="Remove" data-remove>&times;</button>
    <span class="cart__thumb"></span>
    <span class="cart__meta">
      <span class="cart__name"></span>
      <span class="cart__variant"></span>
    </span>
    <span class="cmp-stepper cart__stepper">
      <b data-dec>&minus;</b><b class="v" data-qty>1</b><b data-inc>+</b>
    </span>
    <span class="cart__price"></span>
  </li>
</template>

<script>
  import {
    getCart, setQty, removeItem, findProduct, unitPrice, seedIfFirstVisit, rupiah,
  } from '../../lib/cart';
  import { initAreaPicker, type DeliveryDestination } from '../../lib/area-picker';

  interface RateOption { courier: string; service: string; price: number; etd: string }
  // ongkir & alamat lewat endpoint server (/api/shipping) — token Biteship tidak ke browser
  const getRates = (opts: { destAreaId?: string; destPostal?: number; items: { name: string; quantity: number }[] }): Promise<{ options: RateOption[]; estimated: boolean }> =>
    fetch('/api/shipping', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        destAreaId: opts.destAreaId,
        destPostal: opts.destPostal,
        items: opts.items.map((it) => ({ slug: it.name, qty: it.quantity })),
      }),
    })
      .then((r) => r.json())
      .catch(() => ({ options: [] as RateOption[], estimated: true }));

  const root = document.querySelector<HTMLElement>('[data-cart]');
  if (root) {
    seedIfFirstVisit();

    const $ = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const itemsEl = $('[data-items]');
    const emptyEl = $('[data-empty]');
    const deliveryEl = $('[data-delivery]');
    const formEl = $('[data-form]');
    const totalsEl = $('[data-totals]');
    const tpl = document.querySelector<HTMLTemplateElement>('[data-line-tpl]')!;
    const courierSel = $<HTMLSelectElement>('[data-courier]');
    const courierRow = $('[data-courierrow]');
    const estNote = $('[data-estnote]');
    const dateInput = $<HTMLInputElement>('[data-date]');
    const sendToInput = $<HTMLTextAreaElement>('[data-sendto]');
    let mode = 'delivery';
    const contactInputs = Array.from(root.querySelectorAll<HTMLInputElement>('[data-form] input'));
    const contactStorageKey = 'ania:checkout-contact';
    type PricedItem = { slug: string; name: string; image: string; pill: string; unitPrice: number; priceNote?: string };
    let priced = new Map<string, PricedItem>();
    let pricingRequest = 0;
    let pricingReady = false;
    const currentProduct = (slug: string) => {
      const live = priced.get(slug);
      return live ? { ...live, price: live.unitPrice > 0 ? live.unitPrice : null } : findProduct(slug);
    };
    const currentUnit = (slug: string) => priced.get(slug)?.unitPrice ?? unitPrice(slug);
    const currentSubtotal = () => getCart().reduce((sum, line) => sum + currentUnit(line.slug) * line.qty, 0);

    try {
      const saved = JSON.parse(localStorage.getItem(contactStorageKey) || '{}');
      contactInputs.forEach((input) => {
        if (typeof saved[input.name] === 'string') input.value = saved[input.name];
      });
    } catch {}

    const saveContactDraft = () => {
      const values = Object.fromEntries(contactInputs.map((input) => [input.name, input.value.trim()]));
      localStorage.setItem(contactStorageKey, JSON.stringify(values));
    };
    contactInputs.forEach((input) => input.addEventListener('input', saveContactDraft));

    // default tanggal = besok (waktu lokal)
    const t = new Date(); t.setDate(t.getDate() + 1);
    const iso = `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, '0')}-${String(t.getDate()).padStart(2, '0')}`;
    dateInput.min = iso; dateInput.value = iso;

    let dest: DeliveryDestination = {};
    let rates: RateOption[] = [];
    let estimated = false;
    let rateRequest = 0;
    try {
      const saved = JSON.parse(localStorage.getItem('ania:checkout-delivery') || '{}');
      dest = { areaId: saved.areaId, postal: saved.postal, label: saved.label, cityLabel: saved.cityLabel, districtLabel: saved.districtLabel };
      sendToInput.value = saved.address || '';
      if (saved.date >= iso) dateInput.value = saved.date;
      mode = saved.mode === 'pickup' ? 'pickup' : 'delivery';
    } catch {}
    const saveDeliveryDraft = () => {
      localStorage.setItem('ania:checkout-delivery', JSON.stringify({ ...dest, mode, date: dateInput.value, address: sendToInput.value }));
    };
    dateInput.addEventListener('change', saveDeliveryDraft);
    sendToInput.addEventListener('input', saveDeliveryDraft);

    const renderItems = () => {
      const cart = getCart();
      itemsEl.innerHTML = '';
      cart.forEach((l) => {
        const p = currentProduct(l.slug);
        if (!p) return;
        const node = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
        (node.querySelector('.cart__thumb') as HTMLElement).style.backgroundImage = `url(${p.image})`;
        node.querySelector('.cart__name')!.textContent = p.name;
        node.querySelector('.cart__variant')!.textContent = p.pill;
        node.querySelector('[data-qty]')!.textContent = String(l.qty);
        node.querySelector('.cart__price')!.textContent =
          typeof p.price === 'number' ? rupiah(currentUnit(l.slug) * l.qty) : (p.priceNote ? 'By request' : '—');
        node.querySelector('[data-dec]')!.addEventListener('click', () => setQty(l.slug, l.qty - 1));
        node.querySelector('[data-inc]')!.addEventListener('click', () => setQty(l.slug, l.qty + 1));
        node.querySelector('[data-remove]')!.addEventListener('click', () => removeItem(l.slug));
        itemsEl.appendChild(node);
      });
      const has = cart.length > 0;
      emptyEl.hidden = has;
      deliveryEl.hidden = !has;
      formEl.hidden = !has;
      totalsEl.hidden = !has;
    };

    const deliveryCost = (): number | null => {
      if (mode === 'pickup') return 0;
      if (!rates.length) return null;
      const idx = courierSel.selectedIndex >= 0 ? courierSel.selectedIndex : 0;
      return rates[idx]?.price ?? null;
    };

    const renderTotals = () => {
      const sub = currentSubtotal();
      const ship = deliveryCost();
      $('[data-subtotal]').textContent = rupiah(sub);
      $('[data-delivery-cost]').textContent = ship == null ? '—' : rupiah(ship);
      const total = sub + (ship ?? 0);
      $('[data-total]').textContent = rupiah(total);
      $('[data-checkout-total]').textContent = rupiah(total);
    };

    const loadRates = async () => {
      if (mode === 'pickup' || (!dest.areaId && !dest.postal)) return;
      const request = ++rateRequest;
      const cart = getCart();
      const items = cart.map((l) => ({ name: l.slug, quantity: l.qty }));
      courierSel.innerHTML = '<option>Loading…</option>';
      courierRow.hidden = false;
      const res = await getRates({ destAreaId: dest.areaId, destPostal: dest.postal, items });
      if (mode === 'pickup' || request !== rateRequest) return;
      rates = res.options;
      courierRow.hidden = !rates.length;
      estimated = res.estimated;
      estNote.hidden = !estimated;
      courierSel.innerHTML = rates
        .map((r) => `<option>${r.courier} · ${r.service} — ${rupiah(r.price)}${r.etd ? ` (${r.etd})` : ''}</option>`)
        .join('');
      renderTotals();
    };

    initAreaPicker($('[data-area-picker]'), (destination) => {
      rateRequest++;
      dest = destination;
      rates = [];
      estimated = false;
      estNote.hidden = true;
      courierRow.hidden = true;
      saveDeliveryDraft();
      renderTotals();
      if (dest.areaId || dest.postal) loadRates();
    }, dest);

    courierSel.addEventListener('change', renderTotals);
    const renderMode = () => {
      const pickup = mode === 'pickup';
      $('[data-city-row]').hidden = pickup;
      $('[data-sendto-row]').hidden = pickup;
      courierRow.hidden = pickup || !rates.length;
      estNote.hidden = pickup || !estimated;
      root.querySelectorAll<HTMLElement>('[data-mode]').forEach((button) => {
        const active = button.dataset.mode === mode;
        button.classList.toggle('is-active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      renderTotals();
    };
    root.querySelectorAll<HTMLElement>('[data-mode]').forEach((button) => button.addEventListener('click', () => {
      mode = button.dataset.mode || 'delivery';
      renderMode();
      saveDeliveryDraft();
      if (mode === 'delivery') loadRates();
    }));

    // --- checkout → buat order + invoice Xendit ---
    const waFallback = (code: string) => {
      const cart = getCart();
      // produk yang slug-nya sudah tidak ada di snapshot katalog (mis. dihapus/diganti di admin
      // sejak snapshot terakhir) → jangan crash, lewati saja barisnya di ringkasan WhatsApp.
      const lines = cart
        .map((l) => {
          const p = currentProduct(l.slug);
          if (!p) return null;
          const price = typeof p.price === 'number' ? rupiah(currentUnit(l.slug) * l.qty) : 'By request';
          return `• ${p.name} (${p.pill}) ×${l.qty} — ${price}`;
        })
        .filter((line): line is string => line !== null);
      const ship = deliveryCost();
      const total = currentSubtotal() + (ship ?? 0);
      const msg = [
        `Halo ANIA, saya mau order (kode ${code}):`,
        ...lines,
        '',
        `Subtotal: ${rupiah(currentSubtotal())}`,
        `Ongkir: ${ship == null ? '-' : rupiah(ship)}${mode === 'delivery' && estimated ? ' (estimasi)' : ''} ${mode === 'delivery' ? courierSel.value : ''}`.trim(),
        `Total: ${rupiah(total)}`,
        '',
        `Metode: ${mode === 'pickup' ? 'Pickup' : 'Delivery'}`,
        `Kirim ke: ${mode === 'pickup' ? root.dataset.pickupAddress : [sendToInput.value, dest.label].filter(Boolean).join(', ')}`,
        `Tanggal terima: ${dateInput.value}`,
      ].join('\n');
      window.open(`https://wa.me/${root.dataset.wa}?text=${encodeURIComponent(msg)}`, '_blank');
    };

    const checkoutBtn = $<HTMLButtonElement>('[data-checkout]');
    const refreshPrices = async () => {
      const requestId = ++pricingRequest;
      pricingReady = false;
      checkoutBtn.disabled = true;
      try {
        const response = await fetch('/api/pricing', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: getCart() }) });
        if (!response.ok) throw new Error('Harga belum dapat dimuat. Silakan refresh halaman.');
        const data = await response.json();
        if (requestId !== pricingRequest) return;
        priced = new Map(data.items.map((item: PricedItem) => [item.slug, item]));
        pricingReady = true;
        renderItems(); renderTotals();
        checkoutBtn.disabled = false;
      } catch (error) {
        if (requestId !== pricingRequest) return;
        const note = $('[data-checkoutnote]');
        note.hidden = false; note.textContent = (error as Error).message;
      }
    };
    checkoutBtn.addEventListener('click', async () => {
      if (!pricingReady) return;
      const cart = getCart();
      if (!cart.length) return;
      const note = $('[data-checkoutnote]');
      const name = (root.querySelector('[name="senderName"]') as HTMLInputElement).value.trim();
      const wa = (root.querySelector('[name="senderWa"]') as HTMLInputElement).value.trim();
      const email = (root.querySelector('[name="senderEmail"]') as HTMLInputElement).value.trim();
      if (mode === 'delivery' && (!dest.label || !sendToInput.value.trim())) { note.hidden = false; note.textContent = 'Pilih kota dan lengkapi alamat penerima.'; return; }
      if (!dateInput.checkValidity()) { dateInput.reportValidity(); return; }
      const invalidContact = contactInputs.find((input) => !input.checkValidity());
      if (invalidContact || !name || !wa) {
        note.hidden = false;
        note.textContent = 'Lengkapi nama dan WhatsApp pengirim.';
        invalidContact?.reportValidity();
        invalidContact?.focus();
        return;
      }
      note.hidden = true;

      const chosen = rates[courierSel.selectedIndex >= 0 ? courierSel.selectedIndex : 0];
      checkoutBtn.disabled = true;
      const orig = checkoutBtn.textContent;
      checkoutBtn.textContent = 'Memproses…';
      try {
        const res = await fetch('/api/checkout', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: cart.map((l) => ({ slug: l.slug, qty: l.qty })),
            customer: { name, phone: wa, email },
            shipping: {
              mode,
              areaId: mode === 'delivery' ? dest.areaId : undefined,
              postal: mode === 'delivery' ? dest.postal : undefined,
              address: mode === 'delivery' ? sendToInput.value.trim() : '',
              label: mode === 'pickup' ? root.dataset.pickupAddress : [sendToInput.value.trim(), dest.label].filter(Boolean).join(', '),
              date: dateInput.value,
              courier: mode === 'pickup' ? 'pickup' : chosen?.courier || '',
              service: mode === 'pickup' ? 'Pickup at ANIA' : chosen?.service || '',
              cost: deliveryCost() ?? 0,
            },
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Checkout gagal');
        if (data.invoiceUrl) { window.location.href = data.invoiceUrl; return; }
        // Xendit belum aktif → tampilkan kode order + fallback WhatsApp
        note.hidden = false;
        note.textContent = `Order ${data.code} dibuat. Pembayaran online belum aktif — lanjut via WhatsApp.`;
        waFallback(data.code);
      } catch (err) {
        note.hidden = false;
        note.textContent = (err as Error).message;
      } finally {
        checkoutBtn.disabled = false;
        checkoutBtn.textContent = orig;
      }
    });

    window.addEventListener('cart:change', () => {
      renderItems();
      renderTotals();
      if (dest.areaId || dest.postal) loadRates();
      refreshPrices();
    });

    renderItems();
    renderMode();
    refreshPrices();
    if (mode === 'delivery') loadRates();
  }
</script>

<style>
  .cart { width: 100%; padding: var(--sec-y) var(--gutter); }
  .cart__grid {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(320px, 1fr); gap: 40px;
    width: 100%; max-width: 1100px; margin: 0 auto; padding: 40px;
    background: #fff; border: 1px solid var(--hair); border-radius: 4px;
    box-shadow: 0 4px 20px rgba(61,59,47,.025);
  }
  .cart__left { min-width: 0; padding-right: 40px; border-right: 1px solid var(--hair); }
  .cart__right { min-width: 0; }

  /* ---- items — Figma something.html: garis #BBCCBF (bukan --sand), teks 14px #6D6D6D ---- */
  .cart__items { list-style: none; margin: 0; padding: 0; }
  .cart__item {
    display: grid;
    grid-template-columns: 28px 59px minmax(0, 1fr) auto auto;
    align-items: center; gap: 20px;
    padding: 22px 0; border-bottom: 1px solid #BBCCBF;
  }
  .cart__remove {
    width: 26px; height: 26px; border-radius: 50%; border: 1px solid #BBCCBF;
    background: #fff; color: var(--dim); cursor: pointer; font-size: 15px; line-height: 1;
  }
  .cart__thumb {
    width: 59px; height: 59px; border-radius: 2px;
    background: var(--img-placeholder-warm) center/cover no-repeat;   /* placeholder thumbnail — token sama kayak .cmp-swatch .dot di global.css */
  }
  .cart__meta { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .cart__name { font: 600 14px/1.3 var(--font-sans); color: #6D6D6D; }
  .cart__variant { font: 400 14px/1.3 var(--font-sans); color: #6D6D6D; }
  .cart__stepper b { width: 33px; height: 33px; font-size: 14px; box-shadow: inset 0 0 0 1px #BBCCBF; }
  .cart__price {
    font: 400 14px/1 var(--font-sans); color: #6D6D6D; white-space: nowrap; text-align: right;
  }
  .cart__empty { font: 400 16px/1.6 var(--font-sans); color: var(--dim); }

  /* ---- delivery box — Figma: "Receive on" | "Send to" sebaris (2 kolom), garis #BBCCBF ---- */
  .cart__deliverybox {
    margin: 28px 0 0; border: 1px solid #BBCCBF; border-radius: 6px; overflow: hidden;
    display: grid; grid-template-columns: 1fr 1fr;
  }
  .cart__dcell {
    display: flex; align-items: center; gap: 12px; padding: 14px 16px;
  }
  .cart__dcell[hidden] { display: none; }
  .cart__dcell--addr { position: relative; border-left: 1px solid #BBCCBF; }
  /* baris kurir muncul setelah alamat dipilih — lebar penuh di bawah */
  .cart__dcell--courier { grid-column: 1 / -1; border-top: 1px solid #BBCCBF; }
  .cart__dlabel {
    font: 600 14px/1 var(--font-sans); color: #1E2934; flex: none;
  }
  .cart__dinput {
    flex: 1; border: 0; background: transparent; font: 400 14px/1.4 var(--font-sans);
    color: #3D3B2F; min-width: 0;
  }
  .cart__dinput:focus { outline: none; }
  .cart__addrwrap { position: relative; flex: 1; }
  .cart__addrlist {
    position: absolute; left: 0; right: 0; top: 100%; z-index: 20; margin: 6px 0 0; padding: 4px;
    list-style: none; background: #fff; border: 1px solid var(--hair); border-radius: 8px;
    box-shadow: 0 12px 30px -14px rgba(60, 50, 20, 0.3); max-height: 260px; overflow: auto;
  }
  .cart__addrlist li {
    padding: 8px 10px; border-radius: 6px; cursor: pointer;
    font: 400 14px/1.4 var(--font-sans); color: #3D3B2F;
  }
  .cart__addrlist li:hover { background: var(--soft); }
  .cart__pin { opacity: 0.5; flex: none; }
  .cart__estnote {
    /* bg distandarkan ke var(--field). #7E4C4C BEDA BANGET (lihat saran di .type--sale, global.css) */
    font: 400 12px/1 var(--font-sans); text-transform: uppercase; letter-spacing: 1px;
    color: #7E4C4C; background: var(--field); border-radius: 99px; padding: 3px 8px; flex: none;
  }
  .cart__dcell--courier .cart__dinput { cursor: pointer; }

  /* ---- form — Figma: input outline #D1D1D1, radius 4, tinggi 67 ---- */
  .cart__form { margin: 22px 0 0; display: flex; flex-direction: column; gap: 16px; }
  .cart__formrow { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cart__field { position: relative; display: block; min-width: 0; }
  .cart__field input {
    width: 100%; height: 50px; padding: 0 15px; border-radius: 4px;
    border: 1px solid #D1D1D1; background: #fff;
    font: 400 14px/1 var(--font-sans); color: #3D3B2F;
    transition: border-color .2s ease;
  }
  .cart__field input::placeholder { color: #8E8E93; opacity: 0; transition: opacity .2s ease; }
  .cart__field input:focus::placeholder { opacity: .65; }
  .cart__field input:focus { outline: none; border-color: var(--olive); }
  .cart__field--floating span {
    position: absolute; left: 11px; top: 50%; transform: translateY(-50%);
    padding: 0 5px; background: #fff; pointer-events: none;
    font: 400 13px/1 var(--font-sans); color: #8E8E93;
    transition: top .2s ease, color .2s ease, font-size .2s ease;
  }
  .cart__field--floating input:focus + span,
  .cart__field--floating input:not(:placeholder-shown) + span {
    top: 0; color: #3D3B2F; font-size: 11px;
  }

  /* ---- right — Figma: garis/outline #BBCCBF, tombol radius 4 ---- */
  .cart__continue {
    display: flex; align-items: center; justify-content: center; min-height: 40px; padding: 12px 18px;
    text-decoration: none;
    border: 1px solid #BBCCBF; border-radius: 4px;
    font: 600 12px/1.3 var(--font-sans); letter-spacing: 0; text-transform: uppercase;
    color: #1E2934;
  }
  .cart__totals {
    margin: 24px 0 0; padding: 24px; border: 1px solid #BBCCBF; border-radius: 8px;
  }
  .cart__totalstitle {
    margin: 0 0 6px; font: 600 16px/1.3 var(--font-sans); color: #3D3B2F;
  }
  .cart__row {
    display: flex; justify-content: space-between; align-items: baseline;
    padding: 14px 0; border-bottom: 1px solid #EEEEEE;
    font: 400 16px/1 var(--font-sans); color: #6D6D6D;
  }
  .cart__row b { color: #6D6D6D; font-weight: 400; }
  .cart__row--total { border-bottom: 0; }
  .cart__row--total b { font-weight: 600; color: #3D3B2F; }
  .cart__checkout {
    width: 100%; min-height: 40px; margin: 18px 0 0; padding: 12px 18px; border: 0; border-radius: 4px;
    background: var(--panel); color: #F8F8F8; cursor: pointer;
    font: 700 12px/1.3 var(--font-sans); letter-spacing: 0; text-transform: uppercase;
  }
  .cart__note { margin: 10px 0 0; font-size: 12px; color: #7E4C4C; }   /* #7E4C4C BEDA BANGET, lihat saran di .type--sale (global.css) */

  @media (max-width: 960px) {
    .cart__grid { grid-template-columns: 1fr; }
    .cart__left { padding-right: 0; border-right: 0; }
    .cart__right { padding-left: 0; margin-top: 32px; }
  }
  @media (max-width: 560px) {
    .cart { padding-inline: 16px; }
    .cart__grid { padding: 24px 18px; }
    .cart__formrow { grid-template-columns: 1fr; }
    .cart__item {
      grid-template-columns: 24px 52px minmax(0, 1fr);
      grid-template-areas: 'rm thumb meta' '. step price';
      gap: 12px 14px;
    }
    .cart__remove { grid-area: rm; }
    .cart__thumb { grid-area: thumb; width: 52px; height: 52px; }
    .cart__meta { grid-area: meta; }
    .cart__stepper { grid-area: step; }
    .cart__price { grid-area: price; text-align: left; align-self: center; }
    .cart__deliverybox { grid-template-columns: 1fr; }
