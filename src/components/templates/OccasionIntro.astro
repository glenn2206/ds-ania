---
/**
 * TEMPLATE · OccasionIntro — index.html "What's the Occasion?".
 * Kartu gambar kiri + teks kanan (eyebrow + judul Cormorant 60 + 2 tombol).
 */
import Button from '../atoms/Button.astro';
import { intro } from '../../data/occasions';
---

<section class="ointro">
  <div class="ointro__media" style={`background-image:url(${intro.image})`}></div>
  <div class="ointro__body">
    <span class="ointro__eyebrow">{intro.eyebrow}</span>
    <h1 class="type-h1 ointro__title">{intro.title}</h1>
    <div class="ointro__cta">
      <Button href={intro.primary.href}>{intro.primary.label}</Button>
      <Button variant="secondary" href={intro.secondary.href}>{intro.secondary.label}</Button>
    </div>
  </div>
</section>

<style>
  .ointro {
    display: grid;
    /* 2 kolom sama besar, tengahnya kosong 55px (kalibrasi @1440: pad-x 175px) */
    grid-template-columns: 1fr 1fr;
    gap: 55px;
    align-items: center;
    padding: calc(var(--sec-y) * 0.9) clamp(28px, 12.15vw, 175px);
  }
  .ointro__media {
    aspect-ratio: 530 / 580;
    border-radius: 8px;
    background: var(--img-placeholder) center/cover no-repeat;   /* placeholder bg gambar — distandarkan ke var(--img-placeholder) */
    box-shadow: 0 24px 60px -30px rgba(60, 50, 20, 0.4);
  }
  .ointro__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;                          /* Figma: gap 20 antar blok teks & CTA */
  }
  .ointro__eyebrow {
    font: 600 14px/1 var(--font-sans);
    text-transform: uppercase;
    letter-spacing: 5.6px;
    color: #525252;
  }
  .ointro__title { margin: 0; }
  .ointro__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .ointro__cta :global(.cmp-btn-primary),
  .ointro__cta :global(.cmp-btn-secondary) {
    font-size: 14px;                    /* Figma: tombol section ini 14px (bukan 12px default) */
  }

  @media (max-width: 900px) {
    .ointro {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-left: var(--gutter);
      padding-right: var(--gutter);
    }
    .ointro__media { max-width: 420px; }
    .ointro__title { font-size: 40px; }
  }
  @media (max-width: 480px) {
    .ointro__title { font-size: 32px; }
  }
</style>
