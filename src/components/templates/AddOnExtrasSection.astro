---
/**
 * TEMPLATE · AddOnExtrasSection — "Add On Cute Extras to Your Bouquet!".
 * Judul .type-h2 rata tengah + 4 OccasionCard (action="plus") + tombol "View All Add-on".
 * Pakai kelas .addonx dari global.css (dipakai juga di halaman detail produk).
 */
import OccasionCard from '../organisms/OccasionCard.astro';
import Button from '../atoms/Button.astro';
import { addOnExtras } from '../../data/occasions';

interface Props {
  title?: string;
  cta?: string;
  href?: string;
}
const { title = 'Add On Cute Extras to Your Bouquet!', cta = 'View All Add-on', href = '/shop?filter=addon' } = Astro.props;
---

<section class="addonx">
  <h2 class="type-h2--alt addonx__title">{title}</h2>
  <div class="addonx__row" data-extra-carousel>
    {addOnExtras.map((a) => <OccasionCard image={a.image} title={a.title} price={a.price} action="plus" slug={a.slug} />)}
  </div>
  <div class="addonx__foot"><Button href={href}>{cta}</Button></div>
</section>

<script>
  import { initCardCarousel } from '../../lib/card-carousel';
  document.querySelectorAll<HTMLElement>('[data-extra-carousel]').forEach((row) => initCardCarousel(row));
</script>

<style>
  .addonx__title {
    color: #1E2934;   /* Figma: bukan var(--ink) — font/size sudah dari .type-h2--alt */
  }
  .addonx__foot { display: flex; justify-content: center; margin: 8px 0 0; }
</style>
