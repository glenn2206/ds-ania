---
/**
 * TEMPLATE · TermsSection — index.html "Terms & Condition".
 * Judul + daftar section (subjudul + paragraf justified).
 */
import { termsTitle, termsSections } from '../../data/terms';
---

<section class="terms">
  <h1 class="terms__title">{termsTitle}</h1>

  <div class="terms__body">
    {
      termsSections.map((s) => (
        <div class="terms__block">
          <h2 class="terms__heading">{s.heading}</h2>
          {s.body.map((p) => <p>{p}</p>)}
        </div>
      ))
    }
  </div>
</section>

<style>
  .terms {
    padding: var(--sec-y) var(--gutter);
  }
  .terms__title {
    margin: 0 0 40px;
    text-align: center;
    font: 400 clamp(30px, 3.4vw, 40px) / 1.1 var(--font-display);
    color: #3D3B2F;
  }
  .terms__body {
    max-width: 1180px;
    margin: 0 auto;
  }
  .terms__block { margin: 0 0 40px; }
  .terms__block:last-child { margin-bottom: 0; }
  .terms__heading {
    margin: 0 0 14px;
    font: 400 24px/1.35 var(--font-display);
    color: #525252;
  }
  .terms__block p {
    margin: 0 0 16px;
    font: 400 16px/1.7 var(--font-sans);
    color: #525252;
    text-align: justify;
  }
  .terms__block p:last-child { margin-bottom: 0; }
</style>
