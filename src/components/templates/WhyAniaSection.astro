---
/**
 * TEMPLATE · WhyAniaSection — index.html "Why ANIA?".
 * Judul .ts-07 + grid 4 WhyAniaCard (kartu ke-2 varian soft #F6EBE3).
 */
import WhyAniaCard from '../organisms/WhyAniaCard.astro';

interface Card {
  icon: string;
  title: string;
  body: string;
  soft?: boolean;
  mutedBody?: boolean;
}
interface Props {
  title?: string;
  cards: Card[];
}
const { title = 'Why ANIA?', cards } = Astro.props;
---

<section class="whyania">
  <div class="ts-07" style="display:block;margin:0 0 28px">{title}</div>
  <div class="whyania__grid">
    {cards.map((c, i) => <WhyAniaCard {...c} petals={Math.min(i + 1, 4)} />)}
  </div>
</section>

<style>
  /* selalu rata: 4 kolom → 2 → 1 (tidak pernah "turun 1") */
  .whyania__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .whyania__grid > :global(.whycard) {
    width: 100%;
    height: auto;
    min-height: 260px;
  }
  @media (max-width: 1024px) {
    .whyania__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 560px) {
    .whyania__grid { grid-template-columns: 1fr; max-width: 420px; margin: 0 auto; }
  }
</style>
