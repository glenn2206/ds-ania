---
/**
 * TEMPLATE · VisitSection — index.html "We'd Love to See You".
 * Split: gambar kiri (full-bleed) + info kantor kanan (heading + label + alamat/kontak).
 */
import { office } from '../../data/contact';

interface Props {
  title?: string;
}
const { title = 'We’d Love to See You' } = Astro.props;
---

<section class="visit">
  <div class="visit__img" style={`background-image:url(${office.image})`}></div>
  <div class="visit__inner">
    <h2 class="type-h1 visit__title">{title}</h2>
    <p class="visit__label">{office.label}</p>
    <address class="visit__addr">
      {office.address.map((line) => <>{line}<br /></>)}
      <br />
      <a href={`mailto:${office.email}`}>{office.email}</a><br />
      <a href={`tel:+${office.whatsapp}`}>{office.phone}</a>
    </address>
  </div>
</section>

<style>
  .visit {
    --rule: var(--sand); /* #CCC8A8 — hairline sama seperti "Who Are You Sending Flowers To?" */
    display: grid;
    grid-template-columns: minmax(0, 769fr) minmax(0, 600fr);
    overflow: hidden;
    border-block: 1px solid var(--rule);
  }
  .visit__img {
    align-self: stretch;                 /* selalu setinggi kolom teks */
    height: 100%;
    min-height: 383px;
    background: #eef1f0 center/cover no-repeat;
    border-right: 1px solid var(--rule); /* garis vertikal antara gambar & teks */
  }
  .visit__inner {
    padding: var(--sec-y) var(--gutter);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
  }
  .visit__title { margin: 0; }
  .visit__label {
    margin: 20px 0 0;
    font: 600 14px/1 'Open Sans', Arial, sans-serif;
    text-transform: uppercase;
    letter-spacing: 5.6px;
    color: #525252;
  }
  .visit__addr {
    margin: 20px 0 0;
    font: 400 14px/24px 'Open Sans', Arial, sans-serif;
    font-style: normal;
    color: #525252;
    max-width: 449px;
  }
  .visit__addr a {
    color: inherit;
    text-decoration: none;
  }
  .visit__addr a:hover { color: var(--olive-ink); }

  @media (max-width: 860px) {
    .visit { grid-template-columns: 1fr; }
    .visit__img { min-height: 300px; border-right: 0; border-bottom: 1px solid var(--rule); }
    .visit__title { font-size: 40px; }
  }
  @media (max-width: 480px) {
    .visit__title { font-size: 32px; }
  }
</style>
