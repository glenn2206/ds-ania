---
/**
 * ORGANISME · ShopSidebar — filter halaman Shop dengan 2 state:
 *  - collapsed → rail ikon tipis (56px) di tepi kiri
 *  - expanded  → panel penuh (~264px): heading ikon+label + daftar item,
 *                dorong grid dari 4 → 3 kolom, ada garis pemisah vertikal.
 * <ShopSidebar groups={filters} />
 */
import FilterGroup from '../molecules/FilterGroup.astro';
import type { FilterGroupData } from '../../data/shop';

interface Props {
  groups: FilterGroupData[];
}
const { groups } = Astro.props;

/* ikon per grup (stroke tipis, seragam) */
const ICONS: Record<string, string> = {
  all: '<circle cx="12" cy="12" r="8.5"/><path d="M8.5 10h7M8.5 14h7"/>',
  sale: '<path d="M6 18 18 6"/><circle cx="7.75" cy="7.75" r="2"/><circle cx="16.25" cy="16.25" r="2"/>',
  category:
    '<rect x="3.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.4"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.4"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.4"/>',
  occasion: '<rect x="3.5" y="5" width="17" height="16" rx="2.2"/><path d="M3.5 9.5h17M8.5 3v4M15.5 3v4"/>',
  flower:
    '<circle cx="12" cy="12" r="2.6"/><ellipse cx="12" cy="6.6" rx="2.6" ry="3.6"/><ellipse cx="12" cy="17.4" rx="2.6" ry="3.6"/><ellipse cx="6.6" cy="12" rx="3.6" ry="2.6"/><ellipse cx="17.4" cy="12" rx="3.6" ry="2.6"/>',
  addon: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/>',
};
const iconFor = (g?: string) => ICONS[g ?? ''] ?? ICONS.all;

/* pastikan "Sale" ada (Figma) — sisipkan setelah "All Products" */
const withSale: FilterGroupData[] = groups.some((g) => g.group === 'sale')
  ? groups
  : (() => {
      const out = [...groups];
      const i = out.findIndex((g) => g.group === 'all');
      out.splice(i >= 0 ? i + 1 : 0, 0, { title: 'Sale', group: 'sale' });
      return out;
    })();
---

<aside class="shop__side" aria-label="Product filters">
  {/* tombol buka — absolut di pojok atas rail */}
  <button type="button" class="shop__side-toggle shop__railbtn--toggle" data-side-toggle aria-label="Open filters">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 5v14M5 12h14" />
    </svg>
  </button>

  {/* --- collapsed: rail ikon --- */}
  <div class="shop__rail">
    {
      withSale.map((g) => (
        <button type="button" class="shop__railbtn" data-rail-btn data-rail-group={g.group} aria-label={g.title}>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={iconFor(g.group)}
          />
        </button>
      ))
    }
  </div>

  {/* tombol tutup — absolut di pojok kanan-atas panel */}
  <button type="button" class="shop__side-toggle shop__side-close" data-side-toggle aria-label="Close filters">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>

  {/* --- expanded: panel penuh --- */}
  <div class="shop__side-panel">
    {withSale.map((g) => <FilterGroup {...g} icon={iconFor(g.group)} />)}
  </div>
</aside>
