  },
  addon: { viewBox: '0 0 24 24', html: '<circle cx="12" cy="12" r="8.5"/><path d="M12 8v8M8 12h8"/>' },
};
const iconFor = (g?: string) => ICONS[g ?? ''] ?? ICONS.all;

/* pastikan "Sale" ada (Figma) — sisipkan setelah "All Products" */
const withSale: FilterGroupData[] = groups.some((g) => g.group === 'sale')
  ? groups
  : (() => {
      const out = [...groups];
      const i = out.findIndex((g) => g.group === 'all');
      out.splice(i >= 0 ? i + 1 : 0, 0, { title: 'Sale', group: 'sale' });
      return out;
    })();
---

<aside class="shop__side" aria-label="Product filters">
  {/* --- collapsed: rail ikon --- */}
  <div class="shop__rail">
    {
      withSale.map((g) => (
        <button type="button" class="shop__railbtn" data-rail-btn data-rail-group={g.group} aria-label={g.title}>
          <svg
            viewBox={iconFor(g.group).viewBox}
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            set:html={iconFor(g.group).html}
          />
        </button>
      ))
    }
  </div>

  {/* tombol tutup KHUSUS popup mobile (desktop pakai tombol di baris judul) */}
  <button type="button" class="shop__mobile-close" data-side-toggle aria-label="Close filters">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 6l12 12M18 6 6 18" />
    </svg>
  </button>

  {/* --- expanded: panel penuh (tombol tutup ada di baris judul — lihat ShopSection.astro) --- */}
  <div class="shop__side-panel">
    {withSale.map((g) => <FilterGroup {...g} icon={iconFor(g.group).html} iconViewBox={iconFor(g.group).viewBox} />)}
  </div>
</aside>
