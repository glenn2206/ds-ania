---
/**
 * ORGANISME · Footer — MEMANGGIL Button + IconLink + Icon.
 * CTA bar + kolom link + payment + copyright. Padding dari index.html.
 */
import Button from '../atoms/Button.astro';
import Icon from '../atoms/Icon.astro';
import IconLink from '../molecules/IconLink.astro';
import { flowerStory } from '../../data/about';

// samain persis sama filter /shop (lihat src/pages/shop.astro: ?cat=<slug> / ?filter=addon)
// — 6 kategori + Add On, klik langsung ke shop yang sudah kefilter (bukan cuma /shop polos)
const shop = [
  { label: 'All Products', href: '/shop' },
  { label: 'Preserved Flower', href: '/shop?cat=preserved' },
  { label: 'Bloom Box & Basket', href: '/shop?cat=bloom-box' },
  { label: 'Premium Wrapped Bloom', href: '/shop?cat=premium-wrapped' },
  { label: 'Vase Arrangement', href: '/shop?cat=vase' },
  { label: 'Standing Flower & Flower Board', href: '/shop?cat=standing' },
  { label: 'Accessories', href: '/shop?cat=accessory' },
  { label: 'Add On', href: '/shop?filter=addon' },
];
const resources = [
  { label: 'Terms and Conditions', href: '/terms' },
  { label: 'Frequently Asked Questions', href: '/faq' },
];
const pay = ['visa', 'jcb', 'mastercard', 'googlepay', 'paypal'];
// sumber sama dengan /about (flowerStory.socials) — satu tempat buat update link sosial media
const social = flowerStory.socials;
---

<footer class="ftr">
  <div class="ftr__cta">
    <h2>Find your Perfect Bouquet today!</h2>
    <span class="g">
      <Button href="https://wa.me/6282111091885?text=Halo%20ANIA%2C%20saya%20mau%20tanya%20soal%20bunga.">Ask a Florist Now</Button>
      <Button variant="secondary" href="/shop">Shop Fresh Blooms</Button>
    </span>
  </div>

  <div class="ftr__main">
    <div class="ftr__brand">
      <Icon name="ania-logo" class="logo" alt="ANIA Flower Boutique" width={132} height={93} style="width:132px;height:auto;align-self:center;" />
      <span class="tag">Let Flowers Speak for You</span>
      <div class="ftr__social">
        {social.map((s) => (
          <IconLink icon={s.icon} href={s.href} target={s.href !== '#' ? '_blank' : undefined} rel={s.href !== '#' ? 'noopener noreferrer' : undefined}>
            {s.label}
          </IconLink>
        ))}
      </div>
    </div>

    <div class="ftr__cols">
      <div class="ftr__col">
        <h3>Shop</h3>
        <ul>{shop.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
      </div>
      <div class="ftr__col">
        <h3>Resources</h3>
        <ul>{resources.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
      </div>
      <div class="ftr__col">
        <h3>Help</h3>
        <ul><li><a href="mailto:team@myania.com">team@myania.com</a></li></ul>
      </div>
    </div>

    <div class="ftr__pay">
      {pay.map((p) => <Icon name={p} alt={p} />)}
    </div>
  </div>

  <div class="ftr__copy">&copy; ANIA Boutique Flower</div>
</footer>

<style>
  .ftr__col a { color: inherit; text-decoration: none; }
  .ftr__col a:hover { color: var(--olive-ink); }
</style>
