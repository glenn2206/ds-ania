---
/**
 * ORGANISME · WhyAniaCard — 330×220, 2 varian bg.
 * `petals` (1–4) = jumlah kelopak hiasan di pojok kiri-atas — membentuk bunga
 * bertahap (index.html: kartu 1 = 1 kelopak, kartu 4 = bunga penuh).
 * <WhyAniaCard icon="heart" title="…" body="…" petals={1} mutedBody />
 */
interface Props {
  icon: string;
  title: string;
  body: string;
  mutedBody?: boolean;
  soft?: boolean;
  petals?: number;
}
const { icon, title, body, mutedBody = false, soft = false, petals = 1 } = Astro.props;

// urutan tumbuh: kiri-atas → kanan-atas (mirror H) → kiri-bawah (mirror V) → kanan-bawah (mirror H+V)
const QUAD = ['tl', 'tr', 'bl', 'br'] as const;
const shown = QUAD.slice(0, Math.max(1, Math.min(petals, 4)));
---

<div class:list={['whycard', soft && 'whycard--soft']}>
  <span class="whycard__mark" aria-hidden="true">
    {shown.map((q) => (
      <img class={`whycard__petal whycard__petal--${q}`} src="/assets-svg/30_step-by-step-lfower.svg" alt="" />
    ))}
  </span>
  <div class="whycard__tx">
    <div class="whycard__tt">{title}</div>
    <div class={['whycard__bd', mutedBody && 'whycard__bd--muted'].filter(Boolean).join(' ')}>
      {body}
    </div>
  </div>
</div>
