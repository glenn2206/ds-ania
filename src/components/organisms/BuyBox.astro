---
/**
 * ORGANISME · BuyBox — panel kanan halaman detail: info produk + Delivery Information
 * + Add to Cart / Check Out Now. Pakai Swatch, Biteship autocomplete, cart.
 */
import Pill from '../atoms/Pill.astro';
import Swatch from '../atoms/Swatch.astro';
import DeliveryFields from './DeliveryFields.astro';
import type { CatalogItem } from '../../data/catalog';
import { getCheckoutEnabled } from '../../lib/settings';
const checkoutEnabled = await getCheckoutEnabled();

interface Props {
  item: CatalogItem;
}
const { item } = Astro.props;
const priceLabel =
  typeof item.price === 'number'
    ? 'Rp ' + item.price.toLocaleString('en-US')
    : item.priceNote || 'By request';
const swatchImages = item.image2 ? [item.image, item.image2] : [item.image];
---

<aside class="buybox" data-buybox data-slug={item.slug} data-price={typeof item.price === 'number' ? item.price : 0} data-soldout={item.soldOut ? '1' : undefined}>
  <div class="buybox__head">
    <h1 class="type-h2 buybox__name">{item.name}</h1>
    <Pill>{item.pill}</Pill>
    <p class="buybox__price">{item.compareAt && <del>Rp {item.compareAt.toLocaleString('en-US')}</del>} {priceLabel}</p>
    <Swatch options={['Standard', 'Premium']} images={swatchImages} />
  </div>

  <DeliveryFields />

  {item.soldOut ? (
    <button class="cmp-btn-primary buybox__checkout" type="button" disabled>Sold Out</button>
  ) : (
    <>
      <button class="cmp-btn-secondary buybox__add" type="button" data-add>Add to Cart</button>
      <button class="cmp-btn-primary buybox__checkout" type="button" data-checkout disabled={!checkoutEnabled}>
        Check Out Now — <span data-cotot>{priceLabel}</span>
      </button>
    </>
  )}
</aside>

<script>
  import { addItem, rupiah } from '../../lib/cart';
  import { initDeliveryPin, type DeliveryDestination } from '../../lib/delivery-pin';
  import { deliveryToday } from '../../lib/delivery-policy';
  import { initBranchPicker } from '../../lib/branch-picker';

  document.querySelectorAll<HTMLElement>('[data-buybox]').forEach((box) => {
    if (box.dataset.soldout) return; // tak ada tombol beli untuk item sold out
    const slug = box.dataset.slug!;
    const unit = parseInt(box.dataset.price || '0', 10);
    const $ = <T extends Element = HTMLElement>(s: string) => box.querySelector<T>(s)!;
    const dateInput = $<HTMLInputElement>('[data-date]');
    const coTot = $('[data-cotot]');

    dateInput.value = dateInput.min = deliveryToday();

    let dest: DeliveryDestination = {};
    let mode = 'delivery';
    const branches = initBranchPicker(box, { mode }, () => {});

    const updateTotal = () => {
      coTot.textContent = unit ? rupiah(unit) : 'By request';
    };

    // toggle delivery / pickup
    box.querySelectorAll<HTMLElement>('[data-mode]').forEach((b) => {
      b.addEventListener('click', () => {
        mode = b.dataset.mode || 'delivery';
        branches.setMode(mode);
        box.querySelectorAll('[data-mode]').forEach((x) => { x.classList.remove('is-active'); x.setAttribute('aria-pressed', 'false'); });
        b.classList.add('is-active');
        b.setAttribute('aria-pressed', 'true');
        $('[data-city-row]').hidden = mode === 'pickup';
        $('[data-sendto-row]').hidden = mode === 'pickup';
        updateTotal();
      });
    });

    initDeliveryPin($('[data-pin-picker]'), (destination) => {
      dest = destination;
      branches.setDestination(dest.destination);
    });

    // add to cart
    const addBtn = $('[data-add]');
    const saveDelivery = () => localStorage.setItem('ania:checkout-delivery', JSON.stringify({ ...dest, ...branches.draft(), mode, date: dateInput.value, address: $<HTMLTextAreaElement>('[data-sendto]').value }));
    addBtn.addEventListener('click', () => {
      saveDelivery();
      addItem(slug, 1);
      const o = addBtn.textContent;
      addBtn.textContent = 'Added ✓';
      window.setTimeout(() => (addBtn.textContent = o), 1100);
    });

    // check out now → tambah ke cart, ke halaman /cart
    $('[data-checkout]').addEventListener('click', () => {
      const contact = Object.fromEntries(Array.from(box.querySelectorAll<HTMLInputElement>('[data-form] input')).map((input) => [input.name, input.value.trim()]));
      localStorage.setItem('ania:checkout-contact', JSON.stringify(contact));
      saveDelivery();
      addItem(slug, 1);
      window.location.href = '/cart';
    });

    updateTotal();
  });
</script>
