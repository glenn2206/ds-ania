---
/**
 * ORGANISME · OrderItemCard — MEMANGGIL atom Pill. .mini--order 473, rata tengah.
 * .ts-07 judul + pill + .ts-14 harga + swatch.
 * <OrderItemCard title="A Handful Flower Box" pill="Bloom Box" price="Rp 950,000" />
 */
import Pill from '../atoms/Pill.astro';
import Swatch from '../atoms/Swatch.astro';

interface Props {
  title: string;
  pill?: string;
  price: string;
  swatch?: boolean;
}
const { title, pill, price, swatch = false } = Astro.props;
---

<span class="mini mini--order">
  <span class="ts-07">{title}</span>
  {pill && <Pill>{pill}</Pill>}
  <span class="ts-14">{price}</span>
  {swatch && <Swatch />}
</span>
