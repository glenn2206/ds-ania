---
/**
 * ORGANISME · FloatingWhatsApp — tombol WA melayang (fixed) di landing page.
 * Nomor butik: 0821-1109-1885 → wa.me/6282111091885.
 */
import Icon from '../atoms/Icon.astro';

interface Props {
  phone?: string;
  message?: string;
  label?: string;
}
const {
  phone = '6282111091885',
  message = 'Halo ANIA, saya mau tanya soal bunga.',
  label = 'Chat WhatsApp',
} = Astro.props;
const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a class="wa-float" href={href} target="_blank" rel="noopener" aria-label={label} title={label}>
  <Icon name="whatsapp" alt="" style="width:34px;height:34px" />
</a>

<style>
  /* lingkaran PUTIH + ikon WA hijau bawaan (jangan di-flip / di-filter), 64×64 */
  .wa-float {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 60;
    width: 64px;
    height: 64px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--bg);   /* distandarkan: dulu #ffffff literal (selisih 1 unit R ke --bg) → disamakan */
    box-shadow: 0 8px 22px -6px rgba(0, 0, 0, 0.18), 0 2px 6px rgba(0, 0, 0, 0.1);
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .wa-float:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px -6px rgba(0, 0, 0, 0.22), 0 3px 8px rgba(0, 0, 0, 0.12);
  }
  .wa-float :global(img) {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }
  @media (max-width: 560px) {
    .wa-float { right: 16px; bottom: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wa-float { transition: none; }
  }
</style>
