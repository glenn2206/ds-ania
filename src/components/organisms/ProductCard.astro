---
/**
 * ORGANISME · ProductCard — MEMANGGIL Badge / Button + CardTitleBlock + Swatch.
 * Ukuran asli index.html: lebar 320, media 320×406.
 * `slug` → tombol "Add to Cart" (muncul saat hover) yang benar-benar menambah ke keranjang.
 */
import Badge from '../atoms/Badge.astro';
import Button from '../atoms/Button.astro';
import Swatch from '../atoms/Swatch.astro';
import CardTitleBlock from '../molecules/CardTitleBlock.astro';

interface Props {
  image: string;
  title: string;
  pill?: string;
  price: number | string;
  compareAt?: number | string;
  currency?: string;
  state?: 'default' | 'sale' | 'soldout' | 'hover';
  swatchOptions?: string[];
  swatchImages?: string[];
  slug?: string;
  href?: string;
}
const {
  image,
  title,
  pill,
  price,
  compareAt,
  currency,
  state = 'default',
  swatchOptions,
  swatchImages,
  slug,
  href,
} = Astro.props;
---

<div class="pcard" class:list={[slug && 'pcard--buyable', href && 'pcard--link']}>
  {href && <a class="pcard__link" href={href} aria-label={title} />}
  <div class="pcard__media">
    <img class="ph" src={image} alt={title} loading="lazy" decoding="async" />
    {state === 'sale' && <Badge>Sale</Badge>}
    {state === 'soldout' && <span class="pcard__dim" />}
    {state === 'hover' && !slug && <Button variant="secondary-onwhite">Add to Cart</Button>}
    {
      slug && (
        <button class="cmp-btn-secondary cmp-btn-secondary--onwhite pcard__add" type="button" data-add={slug}>
          Add to Cart
        </button>
      )
    }
  </div>
  <div class="pcard__body">
    <CardTitleBlock
      pill={pill}
      title={title}
      price={price}
      compareAt={compareAt}
      currency={currency}
    />
    <!-- <Swatch options={swatchOptions} images={swatchImages} /> -->
  </div>
</div>

<style>
  .pcard--buyable .pcard__add {
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .pcard--buyable:hover .pcard__add,
  .pcard--buyable:focus-within .pcard__add {
    opacity: 1;
  }
  .pcard__add.is-added {
    background: var(--olive);
    color: #fff;
    outline-color: var(--olive);
  }

  /* seluruh kartu (termasuk gambar) jadi link ke detail */
  .pcard--link { position: relative; }
  .pcard__link { position: absolute; inset: 0; z-index: 1; }
  .pcard__link:focus-visible {
    outline: 2px solid var(--olive-ink);
    outline-offset: 3px;
    border-radius: var(--radius);
  }
  /* gambar dibiarkan DI BAWAH .pcard__link supaya klik foto pun buka detail;
     hanya kontrol interaktif yang diangkat kembali ke atas link.
     CATATAN: .cmp-btn-secondary sudah position:absolute di global.css —
     cukup naikkan z-index, JANGAN set position:relative (left/top:50% bikin geser). */
  .pcard--link .pcard__media > .cmp-btn-secondary { z-index: 2; }
  .pcard--link .cmp-swatch { position: relative; z-index: 2; }

  /* hover kartu: zoom foto + border olive + judul olive */
  .pcard__media .ph { transition: transform 0.45s ease; }
  .pcard--link .pcard__media { transition: box-shadow 0.15s ease; }
  .pcard--link:hover .pcard__media .ph,
  .pcard--link:focus-within .pcard__media .ph { transform: scale(1.045); }
  .pcard--link:hover .pcard__media,
  .pcard--link:focus-within .pcard__media { box-shadow: inset 0 0 0 1px var(--olive); }
  /* .type-h2 dirender komponen anak (CardTitleBlock) → :global biar selector tembus */
  .pcard--link :global(.type-h2) { transition: color 0.15s; }
  .pcard--link:hover :global(.type-h2),
  .pcard--link:focus-within :global(.type-h2) { color: var(--olive-ink); }

  @media (prefers-reduced-motion: reduce) {
    .pcard__media .ph { transition: none; }
    .pcard--link:hover .pcard__media .ph,
    .pcard--link:focus-within .pcard__media .ph { transform: none; }
  }
</style>

<script>
  import { addItem } from '../../lib/cart';
  document.querySelectorAll<HTMLButtonElement>('[data-add]').forEach((btn) => {
    btn.addEventListener('click', () => {
      addItem(btn.dataset.add!, 1);
      const orig = btn.textContent;
      btn.textContent = 'Added ✓';
      btn.classList.add('is-added');
      window.setTimeout(() => {
        btn.textContent = orig;
        btn.classList.remove('is-added');
      }, 1100);
    });
  });
</script>
