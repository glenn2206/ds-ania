---
/**
 * ORGANISME · SearchOverlay — pencarian produk (situs statik → filter di browser).
 * Dipicu tombol [data-search-open] di Navbar. Semua kartu dirender tersembunyi lalu
 * ditampilkan/disusun ulang saat mengetik — pola sama seperti ShopSection.
 */
import ProductCard from './ProductCard.astro';
import Icon from '../atoms/Icon.astro';
import { allProducts } from '../../data/catalog';
import { toProduct } from '../../data/shop';

const searchText = (c: (typeof allProducts)[number]) =>
  [c.name, c.pill, c.flowers, c.occasion ?? '', c.category, c.description]
    .join(' ')
    .toLowerCase();

/** chip pencarian cepat — muncul saat input kosong */
const SUGGESTIONS = ['Roses', 'Peonies', 'Tulips', 'Birthday', 'Anniversary', 'Graduation', 'Bloom Box', 'Sympathy'];
---

<div class="search" data-search hidden>
  <div class="search__inner">
    <div class="search__bar">
      <Icon name="search" size={22} alt="" class="search__mag" />
      <input
        class="search__input"
        type="search"
        data-search-input
        placeholder="Search flowers…"
        autocomplete="off"
        aria-label="Search products"
      />
      <button class="search__clear" type="button" data-search-clear aria-label="Clear search" hidden>
        <span class="search__x" aria-hidden="true"></span>
      </button>
    </div>

    <div class="search__suggest" data-search-suggest hidden>
      <span class="search__suggestlabel">Popular searches</span>
      <div class="search__chips">
        {SUGGESTIONS.map((s) => (
          <button type="button" class="search__chip" data-search-chip={s}>{s}</button>
        ))}
      </div>
    </div>

    <p class="search__count" data-search-count></p>
    <span class="search__rule"></span>

    <div class="search__grid" data-search-grid>
      {
        allProducts.map((c, i) => (
          <div class="search__cell" data-search-cell data-search={searchText(c)} data-index={i} hidden>
            <ProductCard {...toProduct(c)} slug={c.slug} href={`/product/${c.slug}`} />
          </div>
        ))
      }
    </div>

    <p class="search__empty" data-search-empty hidden>Type a flower, colour or occasion to search.</p>

    <div class="search__foot">
      <a class="cmp-btn-primary" href="/shop" data-search-close-link>View All Product</a>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-search]');
  if (root) {
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const grid = root.querySelector<HTMLElement>('[data-search-grid]')!;
    const cells = Array.from(root.querySelectorAll<HTMLElement>('[data-search-cell]'));
    const countEl = root.querySelector<HTMLElement>('[data-search-count]')!;
    const emptyEl = root.querySelector<HTMLElement>('[data-search-empty]')!;
    const clearBtn = root.querySelector<HTMLElement>('[data-search-clear]')!;
    const suggestEl = root.querySelector<HTMLElement>('[data-search-suggest]')!;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DEFAULT_N = 8; // "popular picks" saat input kosong

    const animateIn = (els: HTMLElement[]) => {
      if (reduce) return;
      els.forEach((el, i) => {
        (el.querySelector('.pcard') || el).animate(
          [{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'none' }],
          { duration: 300, delay: Math.min(i, 12) * 30, easing: 'cubic-bezier(.2,.6,.2,1)', fill: 'backwards' },
        );
      });
    };

    const render = () => {
      const q = input.value.trim().toLowerCase();
      const tokens = q.split(/\s+/).filter(Boolean);
      clearBtn.hidden = q.length === 0;

      // input kosong → tampilkan chip + "popular picks" (bukan halaman kosong)
      if (!tokens.length) {
        suggestEl.hidden = false;
        const def = cells.slice(0, DEFAULT_N);
        cells.forEach((c) => (c.hidden = true));
        def.forEach((c) => { c.hidden = false; grid.appendChild(c); });
        countEl.textContent = 'Popular picks';
        emptyEl.hidden = true;
        animateIn(def);
        return;
      }

      suggestEl.hidden = true;
      let n = 0;
      const visible: HTMLElement[] = [];
      cells.forEach((c) => {
        const hit = tokens.every((t) => (c.dataset.search || '').includes(t));
        c.hidden = !hit;
        if (hit) {
          n += 1;
          visible.push(c);
        }
      });
      visible
        .sort((a, b) => +(a.dataset.index || 0) - +(b.dataset.index || 0))
        .forEach((c) => grid.appendChild(c));

      countEl.textContent = `${n} result${n === 1 ? '' : 's'}`;
      emptyEl.textContent = 'No products match your search.';
      emptyEl.hidden = n !== 0;
      animateIn(visible);
    };

    let timer: number | undefined;
    input.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(render, 120);
    });

    root.querySelectorAll<HTMLElement>('[data-search-chip]').forEach((b) =>
      b.addEventListener('click', () => {
        input.value = b.dataset.searchChip || b.textContent || '';
        render();
        input.focus();
      }),
    );

    const open = () => {
      root.hidden = false;
      void root.offsetWidth; // paksa reflow → transisi punya state awal (opacity 0)
      root.classList.add('is-open');
      document.documentElement.style.overflow = 'hidden';
      render();
      window.setTimeout(() => input.focus(), 30);
    };
    const close = () => {
      root.classList.remove('is-open');
      document.documentElement.style.overflow = '';
      const finish = () => { root.hidden = true; input.value = ''; render(); };
      reduce ? finish() : window.setTimeout(finish, 180);
    };

    document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
    root.querySelector('[data-search-clear]')?.addEventListener('click', () => {
      input.value = '';
      render();
      input.focus();
    });
    // klik kartu hasil / "View All Product" → tutup overlay (navigasi tetap jalan)
    grid.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[href]')) close();
    });
    root.querySelector('[data-search-close-link]')?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !root.hidden) close();
    });
    window.addEventListener('resize', () => {
      // biar tidak nyangkut kalau viewport berubah drastis; tidak menutup, cuma jaga scroll-lock
      if (root.hidden) document.documentElement.style.overflow = '';
    });
  }
</script>
