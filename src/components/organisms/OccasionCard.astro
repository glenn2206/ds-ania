---
/**
 * ORGANISME · OccasionCard — MEMANGGIL atom Icon. .mini--occ 321×382.
 * gambar 292×292 + .type-h2 + .type-p2 + ikon aksi (panah / plus).
 * <OccasionCard image="/assets/x.png" title="Plush Doll" price="Rp 50,000" action="plus" slug="addon-plush-doll" />
 * `slug` → gambar & judul jadi link ke /product/<slug> (kecuali href diisi manual).
 * `slug` + action="plus" → tombol "+" benar-benar menambah ke keranjang.
 */
import Icon from '../atoms/Icon.astro';

interface Props {
  image: string;
  title: string;
  price: string;
  action?: 'arrow' | 'plus';
  slug?: string;
  href?: string;
}
const { image, title, price, action = 'arrow', slug, href } = Astro.props;
const link = href ?? (slug ? `/product/${slug}` : undefined);
---

<span class="mini mini--occ">
  {link ? (
    <a class="thumb thumb--link" href={link} style={`background-image:url(${image})`} aria-label={title}></a>
  ) : (
    <span class="thumb" style={`background-image:url(${image})`}></span>
  )}
  <span style="display:flex;justify-content:space-between;align-items:center;width:100%">
    <span>
      {link ? (
        <a class="mini__ttlink type-h2" href={link}>{title}</a>
      ) : (
        <span class="type-h2">{title}</span>
      )}
      <br />
      <span class="type-p2">{price}</span>
    </span>
    {
      action === 'plus' ? (
        slug ? (
          <button class="mini__add" type="button" data-add-extra={slug} aria-label={`Add ${title} to cart`}>
            <Icon name="plus-circle" size={24} alt="" />
          </button>
        ) : (
          <Icon name="plus-circle" size={24} alt="add" />
        )
      ) : (
        <Icon name="arrow-right-black" alt="open" style="width:auto;height:18px" />
      )
    }
  </span>
</span>

<style>
  .thumb--link { display: block; cursor: pointer; transition: transform 0.15s ease; }
  .thumb--link:hover { transform: scale(1.02); }
  .thumb--link:focus-visible { outline: 2px solid var(--olive-ink); outline-offset: 3px; }
  .mini__ttlink { text-decoration: none; color: inherit; transition: color 0.15s ease; }
  .mini__ttlink:hover { color: var(--olive-ink); }
  .mini__add {
    border: 0;
    background: transparent;
    padding: 0;
    line-height: 0;
    cursor: pointer;
    transition: transform 0.12s ease;
  }
  .mini__add:hover { transform: scale(1.15); }
  .mini__add.is-added { transform: scale(1.15); filter: hue-rotate(70deg) saturate(1.5); }
  @media (prefers-reduced-motion: reduce) {
    .thumb--link, .thumb--link:hover { transition: none; transform: none; }
  }
</style>

<script>
  import { addItem } from '../../lib/cart';
  document.querySelectorAll<HTMLButtonElement>('[data-add-extra]').forEach((btn) => {
    btn.addEventListener('click', () => {
      addItem(btn.dataset.addExtra!, 1);
      btn.classList.add('is-added');
      window.setTimeout(() => btn.classList.remove('is-added'), 900);
    });
  });
</script>
