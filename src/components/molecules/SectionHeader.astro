---
/**
 * MOLEKUL · SectionHeader — eyebrow + judul + subjudul (pakai token .ts-*).
 * <SectionHeader eyebrow="ANIA Flower Boutique" title="Flowers They'll Never Forget"
 *                subtitle="..." align="center" />
 * titleClass default .type-h2 (Crimson 32). Override sesuai section.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  align?: 'left' | 'center';
  eyebrowClass?: string;
  titleClass?: string;
  subtitleClass?: string;
  class?: string;
}
const {
  eyebrow,
  title,
  subtitle,
  align = 'center',
  eyebrowClass = 'type-accent2',
  titleClass = 'type-h2',
  subtitleClass = 'type-p1',
  class: extra = '',
} = Astro.props;
---

<div
  class={extra}
  style={`text-align:${align};display:flex;flex-direction:column;align-items:${align === 'center' ? 'center' : 'flex-start'};gap:8px`}
>
  {eyebrow && <span class={eyebrowClass}>{eyebrow}</span>}
  {title && <span class={titleClass}>{title}</span>}
  {subtitle && <span class={subtitleClass}>{subtitle}</span>}
  <slot />
</div>
