---
/**
 * MOLEKUL · PriceGroup — .pcard__price = .type-p2 type--strike (coret) + .type-p2
 * <PriceGroup price={700000} compareAt={950000} />
 * <PriceGroup price="Rp 1,000,000" />
 */
interface Props {
  price: number | string;
  compareAt?: number | string;
  currency?: string;
  class?: string;
}
const { price, compareAt, currency = 'Rp ', class: extra = '' } = Astro.props;

const fmt = (v: number | string | undefined) => {
  if (v === undefined || v === '') return '';
  if (typeof v === 'string') return v;
  return currency + v.toLocaleString('en-US');
};
---

<span class={['pcard__price', extra].filter(Boolean).join(' ')}>
  {compareAt !== undefined && <span class="type-p2 type--strike">{fmt(compareAt)}</span>}
  <span class="type-p2">{fmt(price)}</span>
</span>
