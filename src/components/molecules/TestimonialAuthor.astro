---
/**
 * MOLEKUL · TestimonialAuthor — MEMANGGIL atom Avatar.
 * avatar 48 + nama .ts-35 + kota .ts-50
 * <TestimonialAuthor avatar="/assets/profile-claudia.jpg" name="Claudia S" city="Jakarta Utara" />
 */
import Avatar from '../atoms/Avatar.astro';

interface Props {
  avatar?: string;
  name: string;
  city: string;
}
const { avatar, name, city } = Astro.props;
---

<span class="tcard__by">
  <Avatar src={avatar} />
  <span>
    <span class="ts-35">{name}</span><br />
    <span class="ts-50">{city}</span>
  </span>
</span>
