---
/**
 * MOLEKUL · FilterGroup — MEMANGGIL atom Icon. Satu grup filter sidebar Shop.
 * heading (klik = filter kalau tanpa item) + hairline + daftar item ber-bullet.
 * `collapsible` → klik heading buka/tutup daftar (chevron ikut berputar).
 * Emit data-group / data-value → dibaca engine di ShopSection.
 */
import Icon from '../atoms/Icon.astro';

interface Props {
  title: string;
  /** kunci filter: all | sale | category | occasion | flower | addon */
  group?: string;
  items?: string[];
  collapsible?: boolean;
  active?: string;
}
const { title, group = '', items = [], collapsible = false, active } = Astro.props;

// nilai filter untuk tiap label (category dipetakan ke slug; sisanya = label apa adanya)
const CATEGORY_SLUG: Record<string, string> = {
  'Bloom Box & Basket': 'bloom-box',
  'Premium Wrapped Bloom': 'premium-wrapped',
  'Standing Flower & Flower Board': 'standing',
  Vase: 'vase',
  Accessories: 'accessory',
  'Preserved Flower': 'preserved',
};
const valueFor = (label: string) =>
  group === 'category' ? (CATEGORY_SLUG[label] ?? label.toLowerCase()) : label;
---

<div class="filtergrp" data-collapsible={collapsible && items.length ? '' : undefined}>
  <div class="filtergrp__head" data-collapse-head={collapsible && items.length ? '' : undefined}>
    {
      items.length === 0 ? (
        <a class="filtergrp__title filtergrp__title--link" href="#" data-filter data-group={group} data-value="">
          {title}
        </a>
      ) : (
        <span class="filtergrp__title">{title}</span>
      )
    }
    {collapsible && <Icon name="arrow-down" size={14} alt="toggle" />}
  </div>
  <span class="filtergrp__rule"></span>
  {
    items.length > 0 && (
      <ul class="filtergrp__list">
        {items.map((it) => (
          <li class:list={['filtergrp__item', it === active && 'is-active']}>
            <span class="filtergrp__dot" aria-hidden="true">&bull;</span>
            <a href="#" data-filter data-group={group} data-value={valueFor(it)}>
              {it}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</div>

<script>
  // grup collapsible: klik heading (bukan link filter) → buka/tutup daftar
  document.querySelectorAll<HTMLElement>('[data-collapse-head]').forEach((head) => {
    head.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a[data-filter]')) return;
      head.closest('.filtergrp')?.classList.toggle('is-collapsed');
    });
  });
</script>
