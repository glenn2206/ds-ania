---
/**
 * Site.astro — layout halaman publik: Base + Navbar (sticky) + Footer.
 * Halaman cukup mengisi <slot/>; tidak perlu impor Navbar/Footer lagi.
 */
import Base from './Base.astro';
import Navbar from '../components/organisms/Navbar.astro';
import SearchOverlay from '../components/organisms/SearchOverlay.astro';
import Footer from '../components/organisms/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}
const { title, description, bodyClass } = Astro.props;
---

<Base title={title} description={description} bodyClass={bodyClass} lang="en">
  <Navbar />
  <SearchOverlay />
  <main class="site-main">
    <slot />
  </main>
  <Footer />
</Base>

<script>
  import { initLanguage } from '../lib/i18n';
  initLanguage();
</script>

<script>
  // foto & kartu produk tidak ikut "terangkat" (drag and drop bawaan browser) saat ditarik
  document.addEventListener('dragstart', (e) => {
    if (!(e.target instanceof Element) || !e.target.matches('img, .pcard__link, .choose__tile, .thumb--link')) return;
    e.preventDefault();
    // tanpa drag bawaan, melepas mouse di kartu yang sama dihitung klik → telan supaya produk tidak terbuka
    const swallow = (ev: Event) => { ev.preventDefault(); ev.stopPropagation(); };
    document.addEventListener('click', swallow, { capture: true, once: true });
    document.addEventListener('pointerdown', () => document.removeEventListener('click', swallow, true), { capture: true, once: true });
  });
</script>
