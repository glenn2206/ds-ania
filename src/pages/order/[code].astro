---
export const prerender = false;
import Site from '../../layouts/Site.astro';
import { one, q } from '../../lib/db';

const code = String(Astro.params.code || '');
const order = await one('SELECT * FROM orders WHERE code = ?', [code]);
const items = order ? await q('SELECT * FROM order_items WHERE order_id = ? ORDER BY id', [order.id]) : [];
const rp = (n: unknown) => 'Rp ' + Number(n || 0).toLocaleString('id-ID');

const STATUS: Record<string, { label: string; tone: string }> = {
  pending: { label: 'Menunggu pembayaran', tone: '#8a6d2f' },
  paid: { label: 'Lunas — pesanan diproses', tone: '#4c5c2f' },
  fulfilled: { label: 'Selesai dikirim', tone: '#4c5c2f' },
  expired: { label: 'Kedaluwarsa', tone: '#a23b2e' },
  failed: { label: 'Pembayaran gagal', tone: '#a23b2e' },
  cancelled: { label: 'Dibatalkan', tone: '#a23b2e' },
};
const st = order ? STATUS[order.status] ?? { label: order.status, tone: '#555' } : null;
---

<Site title={`Order ${code} — ANIA Flower Boutique`}>
  <div class="orderpage" style="max-width:640px;margin:0 auto;padding:64px var(--gutter) 96px">
    {!order ? (
      <>
        <h1 class="type-h2">Order tidak ditemukan</h1>
        <p>Kode <b>{code}</b> tidak cocok. Cek kembali tautan dari email/WhatsApp kamu.</p>
        <p><a class="cmp-btn-primary" href="/shop">Kembali belanja</a></p>
      </>
    ) : (
      <>
        <p style="letter-spacing:.12em;text-transform:uppercase;font-size:12px;color:var(--dim)">Order {order.code}</p>
        <h1 class="type-h2" style="margin:.2em 0 .1em">{st!.label}</h1>
        <p style="color:{st!.tone};font-weight:600;margin:0 0 24px">
          {order.status === 'pending' && order.xendit_invoice_url
            ? <a class="cmp-btn-primary" href={order.xendit_invoice_url}>Bayar sekarang</a>
            : null}
        </p>

        <table style="width:100%;border-collapse:collapse;font-size:14px">
          <tbody>
            {items.map((it) => (
              <tr>
                <td style="padding:8px 0;border-bottom:1px solid var(--sand)">{it.name} × {it.qty}</td>
                <td style="padding:8px 0;border-bottom:1px solid var(--sand);text-align:right">{rp(it.line_total)}</td>
              </tr>
            ))}
            <tr>
              <td style="padding:8px 0">Subtotal</td>
              <td style="padding:8px 0;text-align:right">{rp(order.subtotal)}</td>
            </tr>
            <tr>
              <td style="padding:8px 0">Ongkir {order.courier} {order.courier_service}</td>
              <td style="padding:8px 0;text-align:right">{rp(order.shipping_cost)}</td>
            </tr>
            <tr>
              <td style="padding:10px 0;font-weight:700;border-top:2px solid var(--ink)">Total</td>
              <td style="padding:10px 0;font-weight:700;border-top:2px solid var(--ink);text-align:right">{rp(order.total)}</td>
            </tr>
          </tbody>
        </table>

        <p style="margin-top:24px;color:var(--dim);font-size:13px">
          Kirim ke: {order.ship_address || '—'}<br />
          Atas nama: {order.customer_name} · {order.customer_phone}
        </p>
      </>
    )}
  </div>
</Site>
