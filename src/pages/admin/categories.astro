---
/** PAGE · /admin/categories — tambah, ubah nama, urutkan, sembunyikan kategori produk. */
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
import CategoryEditor from '../../components/admin/CategoryEditor.tsx';
import { getSession } from '../../lib/session';
import { q } from '../../lib/db';
import { getCategories, getCategoryOverrides } from '../../lib/categories';
import { getCatalog } from '../../lib/products';
import { buildFacets } from '../../lib/facets';
import { chooseTilesFrom } from '../../data/choose';

const session = getSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const categories = await getCategories(true);
const known = new Set(categories.map((c) => c.slug));
const overrides = await getCategoryOverrides();
const counts: Record<string, number> = {};
for (const p of await q('SELECT id, category FROM products')) {
  const extra = overrides.get(Number(p.id));
  const slug = extra && known.has(extra) ? extra : p.category;
  counts[slug] = (counts[slug] || 0) + 1;
}
const catalog = await getCatalog();
const defaults = categories.map(({ image, ...c }) => c); // foto bawaan, dipakai saat foto CMS dihapus
const tiles = Object.fromEntries(
  chooseTilesFrom(buildFacets(catalog.allProducts, defaults)).Category.map((t) => [new URLSearchParams(t.href.split('?')[1]).get('cat')!, t.image]),
);
---

<Admin title="Kategori — ANIA CMS" active="categories" user={session.uname}>
  <h1 class="admin-h">Kategori</h1>
  <p style="color:var(--a-muted);font-size:13px">
    Urutan dan nama dipakai di seluruh situs. Hilangkan centang Tampil untuk menyembunyikan kategori dari menu dan Belanja.
  </p>
  <CategoryEditor client:load categories={categories} counts={counts} tiles={tiles} />
</Admin>
