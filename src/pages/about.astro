---
/**
 * PAGE · /about — SSR so CMS media changes appear without rebuilding.
 */
export const prerender = false;
import Site from '../layouts/Site.astro';
import AboutHero from '../components/templates/AboutHero.astro';
import BehindTheFlower from '../components/templates/BehindTheFlower.astro';
import AboutCollage from '../components/templates/AboutCollage.astro';
import FlowerStory from '../components/templates/FlowerStory.astro';
import { getMedia } from '../lib/settings';
const media = await getMedia();
---

<Site
  title="About Us — ANIA Flower Boutique"
  description="Who we are — a team that believes flowers say what words can't, committed to every detail from first stem to final delivery."
>
  <div class="aboutpage">
    <AboutHero />
    <BehindTheFlower />
    <AboutCollage />
    {media.aboutVideo && <section class="about-video"><video controls preload="metadata" playsinline src={media.aboutVideo} aria-label="ANIA Flower Boutique" /></section>}
    <FlowerStory />
  </div>
</Site>

<style>
  .about-video { padding: 40px var(--gutter); }
  .about-video video { display: block; width: 100%; max-height: 700px; object-fit: contain; border-radius: 8px; background: #fff; }
</style>
