---
import Site from '../../layouts/Site.astro';
import ProductDetailSection from '../../components/templates/ProductDetailSection.astro';
import CareInstructions from '../../components/templates/CareInstructions.astro';
import ProductCard from '../../components/organisms/ProductCard.astro';
import OccasionCard from '../../components/organisms/OccasionCard.astro';
import { toProduct } from '../../data/shop';
import { addonExtras } from '../../data/care';
import { getCatalog, getProductBySlug } from '../../lib/products';

const { slug } = Astro.params;
const item = await getProductBySlug(slug ?? '');
if (!item) return new Response('Produk tidak ditemukan', { status: 404 });
const images = (item.gallery?.length ? item.gallery : [item.image, item.image2].filter(Boolean)) as string[];
const { premiumWrapped } = await getCatalog();
const others = premiumWrapped.filter((product) => product.slug !== item.slug);
const start = Math.max(0, premiumWrapped.findIndex((product) => product.slug === item.slug));
const related = [...others.slice(start), ...others.slice(0, start)].slice(0, 24);
---

<Site title={`${item.name} — ANIA Flower Boutique`} description={item.description.slice(0, 150)}>
  <div class="ppage">
    <ProductDetailSection item={item} images={images} />
    <section class="related">
      <h2 class="type-h2 related__title">You May Also Like</h2>
      <div class="related__row" data-product-carousel>
        {related.map((product) => <ProductCard {...toProduct(product)} slug={product.slug} href={`/product/${product.slug}`} />)}
      </div>
    </section>
    <section class="addonx">
      <h2 class="type-h2 addonx__title">Add On Cute Extras to Your Bouquet!</h2>
      <div class="addonx__row" data-product-carousel>
        {addonExtras.map((addon) => <OccasionCard image={addon.image} title={addon.title} price={addon.price} action="plus" slug={addon.slug} />)}
      </div>
    </section>
    <CareInstructions />
  </div>
</Site>

<script>
  import { initCardCarousel } from '../../lib/card-carousel';
  document.querySelectorAll<HTMLElement>('[data-product-carousel]').forEach((row) => initCardCarousel(row));
</script>
